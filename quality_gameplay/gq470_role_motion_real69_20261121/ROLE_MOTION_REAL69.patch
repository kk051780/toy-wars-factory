+-- BASIC has its own server-owned serial; never synthesize a skill signature.
+-- Per-character observer tokens invalidate already queued local callbacks.
+-- The numeric attribute has no server character/match epoch: this is not proof
+-- against arbitrary old network values arriving after a new character binds.
+local basicObservers:{[number]:any}={}
+local BASIC_ROLES={WARRIOR=true,MAGE=true,NINJA=true,TRAPPER=true,
+ BUILDER=true,BEAST=true,ZOMBIE=true}
+local function basicSerial(player:Player):number?
+ local value=player:GetAttribute("EGGRUMBLE_BasicCastSerial")
+ if type(value)~="number" or value~=value or value<=0
+  or value==math.huge or value%1~=0 then return nil end
+ return value
+end
+local function startCast(player:Player,role:string,slot:string,origin:string)
+ local c=player.Character
+ local hum=c and c:FindFirstChildOfClass("Humanoid")
+ if not c or not hum or hum.Health<=0 then return end
+ local previous=active[player.UserId]
+ if origin=="BASIC" and previous and previous.origin=="SKILL"
+  and previous.char==c and os.clock()-previous.start<previous.duration then return end
+ local count=0
+ for _ in pairs(active) do count+=1 end
+ if count>=MAX_ANIMATED_AVATARS and not active[player.UserId] then return end
+ if active[player.UserId] then resetPose(active[player.UserId]) end
+ active[player.UserId]={
+  player=player,char=c,role=role,slot=slot,start=os.clock(),origin=origin,
+  duration=DURATION[slot] or .3,joints=joints(c),
+  lastApplied={},lastDelta={},
+ }
+end
