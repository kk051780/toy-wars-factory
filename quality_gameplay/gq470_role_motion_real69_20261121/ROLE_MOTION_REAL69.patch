+local function watchBasic(player:Player)
+ local uid=player.UserId
+ local binding:any={player=player,sequence=0}
+ basicObservers[uid]=binding
+ local function bind(character:Model?)
+  if basicObservers[uid]~=binding then return end
+  if binding.changed then binding.changed:Disconnect() end
+  local token={}
+  binding.token=token;binding.character=character
+  -- A present serial is a baseline, including on respawn; do not replay it.
+  binding.sequence=basicSerial(player) or 0
