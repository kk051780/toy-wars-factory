+local function touchJumpGeometry()
+ if not UserInputService.TouchEnabled then return end
+ local touchGui=playerGui:FindFirstChild("TouchGui")
+ if not touchGui or not touchGui:IsA("ScreenGui") or not touchGui.Enabled then return end
+ local controls=touchGui:FindFirstChild("TouchControlFrame")
+ if not controls or not controls:IsA("GuiObject") or not controls.Visible then return end
+ local jump=controls and controls:FindFirstChild("JumpButton")
