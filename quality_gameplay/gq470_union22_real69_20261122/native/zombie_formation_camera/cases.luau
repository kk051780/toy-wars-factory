local function assertUntouched(current,wanted,label)
 assert(current.CameraSubject==wanted and current.writes==0,label)
end
local function fresh(kind,value)
 remove(player)
 advance(4.1)
 local newCamera=camera(kind,value)
 selectCamera(newCamera)
 return newCamera
end
local case=(...)
if case=="OFF" then
 local old=fresh(Enum.CameraType.Custom,nil)
 local body=character(100)
 spawn(player,body)
 advance(4.1)
 assertUntouched(old,nil,"physically previous source has no CameraSubject recovery")
 player:SetAttribute("EGGRUMBLE_Role","MAGE")
 player:SetAttribute("EGGRUMBLE_SkillCastSignature","MAGE:A:1")
 assert(active[player.UserId] and active[player.UserId].char==body,"legacy cast watcher still active")
 print("CAMERA_981_PHYSICAL_OFF_PREVIOUS_MOTION_ONLY_PASS")
 return
end
local custom=Enum.CameraType.Custom

local cam=fresh(custom,nil)
local c,h=character(100)
spawn(player,c)
assert(#queued==5,"exactly five bounded callbacks on actual local join")
advance(.09)
assertUntouched(cam,nil,"no eager camera write")
advance(.02)
assert(cam.CameraSubject==h and cam.writes==1,"nil subject routes to own current living Humanoid")
advance(3.5)
assert(cam.writes==1,"queued callbacks do not rewrite after recovery")
print("CAMERA_981_NIL_SUBJECT_FIVE_RETRIES_PASS")

h.Health=0
local nextChar,nextHum=character(100)
spawn(player,nextChar)
advance(.12)
assert(cam.CameraSubject==nextHum and cam.writes==2,"dead previously owned Humanoid is recoverable")
cam=fresh(custom,nil)
c,h=character(0)
local liveReplacement=subject("Humanoid",c,100)
table.insert(c.children,liveReplacement)
rawset(cam,"_subject",h)
spawn(player,c)
advance(.12)
assert(cam.CameraSubject==liveReplacement and cam.writes==1,"same model's dead subject can use its live replacement")
print("CAMERA_981_DEAD_CURRENT_AND_PROVEN_PREVIOUS_OWN_PASS")

local other,otherHum=character(100)
cam=fresh(custom,otherHum)
c,h=character(100);spawn(player,c)
advance(.12)
otherHum.Health=0;otherHum.Parent=nil
advance(3.2)
assertUntouched(cam,otherHum,"foreign ownership survives living and detached/dead")
local rig=subject("Part",nil,nil)
cam=fresh(custom,rig);c=character(100);spawn(player,c);advance(3.3)
assertUntouched(cam,rig,"a detached observer/camera rig remains authoritative")
local vehicle=subject("VehicleSeat",workspace,nil)
cam=fresh(custom,vehicle);c=character(100);spawn(player,c);advance(.12)
vehicle.Parent=nil;advance(3.2)
assertUntouched(cam,vehicle,"a vehicle seat remains authoritative")
cam=fresh(Enum.CameraType.Scriptable,nil);c=character(100);spawn(player,c);advance(3.3)
assertUntouched(cam,nil,"Scriptable camera preserved")
cam=fresh(Enum.CameraType.Fixed,nil);c=character(100);spawn(player,c);advance(3.3)
assertUntouched(cam,nil,"Fixed camera preserved")
cam=fresh(custom,nil);c,h=character(100);rawset(cam,"_subject",h);spawn(player,c);advance(3.3)
assertUntouched(cam,h,"valid own camera remains unchanged")
local previous=h
local body=character(100)
spawn(player,body);advance(3.3)
assertUntouched(cam,previous,"live previous own subject remains preserved")
print("CAMERA_981_FOREIGN_DETACHED_RIG_SEAT_SCRIPTABLE_FIXED_AND_VALID_SUBJECT_PASS")

cam=fresh(custom,nil);c=character(100);spawn(player,c);remove(player)
advance(3.3)
assertUntouched(cam,nil,"removed character cannot bind during retries")
cam=fresh(custom,nil);c=character(100);spawn(player,c)
local otherCamera=camera(custom,nil)
selectCamera(otherCamera)
selectCamera(cam)
advance(3.3)
assertUntouched(cam,nil,"camera replacement prevents stale generation even after ABA")
assertUntouched(otherCamera,nil,"replacement camera is not touched by old callbacks")
cam=fresh(custom,nil);c=character(100);spawn(peer,c);advance(3.3)
assertUntouched(cam,nil,"foreign Player.CharacterAdded does not drive local camera")
print("CAMERA_981_STALE_CHARACTER_WRONG_PLAYER_AND_CAMERA_REPLACEMENT_PASS")

cam=fresh(custom,nil)
selectCamera(nil)
c=character(nil);spawn(player,c);advance(1.0)
selectCamera(cam)
advance(1.08)
local lateOwn=subject("Humanoid",c,100)
table.insert(c.children,lateOwn)
advance(1.16)
assert(cam.CameraSubject==lateOwn and cam.writes==1,"initial nil camera and delayed Humanoid within bound recover")
cam=fresh(custom,nil);c=character(nil);spawn(player,c);advance(4.05)
lateOwn=subject("Humanoid",c,100);table.insert(c.children,lateOwn);advance(1)
assertUntouched(cam,nil,"Humanoid too late never binds")
print("CAMERA_981_INITIAL_NIL_CAMERA_LATE_HUMANOID_AND_WINDOW_EXPIRY_PASS")

cam=fresh(custom,nil);c=character(100);player:SetAttribute("EGGRUMBLE_Eliminated",true)
spawn(player,c);advance(3.3)
assertUntouched(cam,nil,"observer phase nil camera preserved")
player:SetAttribute("EGGRUMBLE_Eliminated",false)
cam=fresh(custom,nil);c=character(100);c:SetAttribute("EGGRUMBLE_Downed",true)
spawn(player,c);advance(3.3)
assertUntouched(cam,nil,"downed character nil camera preserved")
cam=fresh(custom,nil);c=character(100);spawn(player,c);advance(.12)
player:SetAttribute("EGGRUMBLE_Role","NINJA")
player:SetAttribute("EGGRUMBLE_BasicCastSerial",2)
assert(active[player.UserId] and active[player.UserId].char==c and active[player.UserId].origin=="BASIC")
player:SetAttribute("EGGRUMBLE_SkillCastSignature","NINJA:A:1")
assert(active[player.UserId].origin=="SKILL")
remove(player)
assert(not active[player.UserId],"camera did not disrupt pose cleanup on removal")
print("CAMERA_981_ELIMINATED_DOWNED_AND_EXISTING_BASIC_SKILL_LIFECYCLE_PASS")
