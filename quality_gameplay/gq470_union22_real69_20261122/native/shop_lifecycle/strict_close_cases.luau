case('normal_x_releases_exact_gui_once_and_can_reopen', 'FAIL', function()
 local f=fixture()
 for attempt=1,3 do
  local owned=open(f)
  local unrelated=f.Instance.new('ScreenGui')
  unrelated.Name='EGGRUMBLE_LobbyShop'
  unrelated.Parent=f.playerGui
  local button=owned:FindFirstChild('ShopWindow'):FindFirstChild('Close')
  button.Activated:Fire()
  f:assertNoErrors()
  f:check(owned.Destroyed and owned.Parent==nil and owned.DestroyAttempts==1,'owned X destruction count')
  f:check(unrelated.Parent==f.playerGui and not unrelated.Destroyed,'X altered unrelated same-name window')
  f:check(f:observerCount()==0,'manual X left a heartbeat observer')
  unrelated:Destroy()
 end
end)

case('stale_destroy_callback_preserves_new_request_and_foreign_window','PASS',function()
 local f=fixture()
 local old=open(f)
 local queued=old.Destroying.connections[1].callback
 f:active('TEAM')
 f:heartbeat()
 f:assertNoErrors()
 f:check(old.Destroyed and old.DestroyAttempts==1 and f:observerCount()==0,'own retirement did not destroy once')
 f.team:SetAttribute('EGGRUMBLE_MatchPhase','WAITING')
 local new=open(f)
 local foreign=f.Instance.new('ScreenGui')
 foreign.Name=new.Name
 foreign.Parent=f.playerGui
 queued()
 f:assertNoErrors()
 f:check(new.Parent==f.playerGui and foreign.Parent==f.playerGui and f:observerCount()==1,'old callback claimed new GUI')
 f:active('TEAM')
 f:heartbeat()
 f:assertNoErrors()
 f:check(new.Destroyed and new.DestroyAttempts==1 and not foreign.Destroyed and f:observerCount()==0,'did not retire only active request')
end)

case('manual_x_then_reopen_walk_queue_and_active','FAIL',function()
 local f=fixture()
 local first=open(f)
 f:close()
 f:assertNoErrors()
 local gui=open(f)
 f:check(gui~=first and first.Destroyed,'same window after X')
 f.root.Position=f.Vector3.new(17,0,0)
 f:heartbeat()
 f.player:SetAttribute('EGGRUMBLE_QueuedMode','TEAM')
 f:heartbeat()
 f:check(f:gui()==gui and gui.Enabled,'lost read-only shop before ACTIVE')
 f:active('TEAM')
 f:heartbeat()
 noWindow(f,'ACTIVE left former window')
 f:check(gui.DestroyAttempts==1 and f:observerCount()==0,'ACTIVE left a request')
end)
