local cue=assert(gui:FindFirstChild("ServerAcceptedCastCue"))
local pool=assert(soundService:FindFirstChild("EGGRUMBLE_GQ_ConfirmedHitAudio"))
local function finishSounds()
 for _,sound in ipairs(pool:GetChildren()) do sound:Stop() end
end
local function cast(role,slot,seq)
 player:SetAttribute("EGGRUMBLE_SkillCastSignature",role..":"..slot..":"..seq)
end
local function generic()
 assert(cue.Visible and cue.Rotation==0 and cue.Size.x==20 and cue.Size.y==3)
 assert(tweens[#tweens].duration==.18 and tweens[#tweens].goal.Position==nil)
end
local wind="EGGRUMBLE_SKILL_A_風切弾"
local stone="EGGRUMBLE_SKILL_A_石弾"
local star="EGGRUMBLE_SKILL_A_星弾"
local ice="EGGRUMBLE_SKILL_A_氷弾"

assert(#pool:GetChildren()==4 and #played==0 and #tweens==0)
equip(wind)
cast("MAGE","A",18)
generic()
assert(#played==0,"lower preloaded server sequence cannot play specialized sound")
advance(.40)
cast("MAGE","A",20)
assert(cue.Rotation==-12 and cue.Position.x==.477 and tweens[#tweens].goal.Position.x==.523)
assert(#played==1 and played[1].id=="rbxasset://sounds/action_jump.mp3")
assert(played[1].volume<.14 and played[1].voice.Name=="ConfirmedHit_4")
advance(.04)
player:SetAttribute("EGGRUMBLE_ImpactRole","MAGE")
player:SetAttribute("EGGRUMBLE_ImpactSlot","A")
player:SetAttribute("EGGRUMBLE_ImpactWeight",1)
player:SetAttribute("EGGRUMBLE_ImpactSequence",1)
assert(#played==2 and played[2].id=="rbxasset://sounds/impact_water.mp3")
assert(played[2].voice.Name=="ConfirmedHit_1" and played[2].volume>.18)
assert(#pool:GetChildren()==4,"no new voices or hit-window suppression")
advance(.36);finishSounds()

local oldAvatar=player.Character
player.CharacterRemoving:Fire(oldAvatar)
local newAvatar=avatar("R15")
player.Character=newAvatar
player.CharacterAdded:Fire(newAvatar)
equip(stone)
cast("MAGE","A",21)
assert(cue.Size.x==7 and cue.Size.y==7 and tweens[#tweens].goal.Position.y==.543)
assert(#played==3 and played[3].id=="rbxasset://sounds/action_jump_land.mp3")
advance(.35);finishSounds()
equip(star)
cast("MAGE","A",22)
assert(cue.Rotation==90 and cue.Size.x==16 and tweens[#tweens].duration==.22)
assert(#played==4 and played[4].id=="rbxasset://sounds/impact_water.mp3"
 and played[4].volume<played[2].volume and played[4].speed>played[2].speed)
assert(player.Character==newAvatar and #newAvatar:GetChildren()==2)
print("MAGE_CAST_CUE_THREE_DISTINCT_LOCAL_DIRECTIONS_AND_EXISTING_AUDIO_POOL_PASS")

workspace:SetAttribute("P0D_ENABLE_PRIVATE_MAGE_PROJECTILES",false)
assert(not cue.Visible and not played[4].voice.IsPlaying and tweens[#tweens].cancelled)
advance(.4)
cast("MAGE","A",23)
generic()
assert(#played==4,"dynamic OFF ignores a stale special Tool ID while keeping original cue")
workspace:SetAttribute("P0D_ENABLE_PRIVATE_MAGE_PROJECTILES",true)
advance(.4)
equip(ice)
cast("MAGE","A",24)
generic();assert(#played==4)
advance(.4);equip(wind);cast("MAGE","B",25)
generic();assert(#played==4)
advance(.4);cast("MAGE","C",26)
generic();assert(#played==4)
advance(.4);cast("WARRIOR","A",27)
generic();assert(#played==4)
advance(.4);player:SetAttribute("EGGRUMBLE_Role","WARRIOR");cast("MAGE","A",28)
generic();assert(#played==4)
advance(.4);player:SetAttribute("EGGRUMBLE_Role","MAGE")
player:SetAttribute("EGGRUMBLE_GrowthActive",false);cast("MAGE","A",29)
generic();assert(#played==4)
advance(.4);player:SetAttribute("EGGRUMBLE_GrowthActive",true)
local ambiguous=instance("Tool")
ambiguous:SetAttribute("EGGRUMBLE_InternalToolId",stone)
ambiguous.Parent=player.Character
cast("MAGE","A",30)
generic();assert(#played==4)
advance(.4);equip(star)
player:SetAttribute("EGGRUMBLE_SFXMuted",true)
cast("MAGE","A",31)
assert(cue.Rotation==90 and #played==4,"mute does not affect the cast cue")
advance(.4);player:SetAttribute("EGGRUMBLE_ReducedEffects",true)
player:SetAttribute("EGGRUMBLE_SFXMuted",false)
local tweensBefore=#tweens
cast("MAGE","A",32)
assert(#tweens==tweensBefore and #played==4)
advance(.4);player:SetAttribute("EGGRUMBLE_ReducedEffects",false)
local humanoid=newAvatar:FindFirstChildOfClass("Humanoid")
humanoid.Health=0;humanoid.HealthChanged:Fire(0);cast("MAGE","A",33)
assert(#tweens==tweensBefore and #played==4)
advance(.4);humanoid.Health=100;humanoid.HealthChanged:Fire(100)
cast("MAGE","A",34)
assert(cue.Rotation==90 and #played==5)
player.CharacterRemoving:Fire(newAvatar)
assert(not cue.Visible and not played[5].voice.IsPlaying)
print("MAGE_CAST_CUE_OFF_LEGACY_OTHER_SLOT_AMBIGUITY_AND_LIFECYCLE_PASS")

local replacement=avatar("R6")
player.Character=replacement
player.CharacterAdded:Fire(replacement)
for seq=2,3 do
 advance(.30)
 player:SetAttribute("EGGRUMBLE_ImpactSequence",seq)
end
advance(.30);finishSounds();equip(star);cast("MAGE","A",35)
local reusable=played[#played].voice
assert(reusable.Name=="ConfirmedHit_4" and reusable.Volume==.092)
advance(.16)
player:SetAttribute("EGGRUMBLE_ImpactSequence",4)
assert(played[#played].voice==reusable and reusable.Volume>.18)
workspace:SetAttribute("P0D_ENABLE_PRIVATE_MAGE_PROJECTILES",false)
assert(not cue.Visible and reusable.IsPlaying,"OFF may not stop an original hit that took the same voice")
print("MAGE_CAST_CUE_LEGACY_HIT_POOL_PREEMPTION_PASS")
