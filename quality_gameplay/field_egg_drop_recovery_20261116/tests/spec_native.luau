-- Native Luau VM runs the exact authored Drop body above this snippet.
local n=0
local function check(condition:boolean,msg:string)
 assert(condition,msg)
 n+=1
end
local function field(mode:string,rootX:number,rootZ:number,
 impactX:any,impactZ:any,homeX:any,homeZ:any)
 return Drop.recover(mode,rootX,rootZ,impactX,impactZ,homeX,homeZ)
end
local a=field("TEAM",0,4,-620,465,-885,260)
check(a.x==-620 and a.z==465,"TEAM center must be untouched")
check(not a.corrected,"valid center must not be corrected")
check(a.minX==-1025 and a.maxX==-215,"TEAM horizontal protected bounds")
check(a.minZ==-16 and a.maxZ==950,"TEAM vertical protected bounds")
local b=field("BATTLE_ROYALE",0,4,620,465,620,280)
check(b.x==620 and not b.corrected,"BR center unchanged")
check(b.minX==215 and b.maxX==1025,"BR x is in opposite arena")
local c=field("TEAM",0,4,5000,5000,-885,260)
check(c.x==-215 and c.z==950,"far positive fall clamps inside TEAM")
check(c.corrected,"positive out-of-bounds corrected")
local d=field("BATTLE_ROYALE",0,4,-5000,-5000,620,280)
check(d.x==215 and d.z==-16,"far negative fall clamps inside BR")
check(d.corrected,"negative out-of-bounds corrected")
local e=field("TEAM",20,200,-100000,100000,nil,nil)
check(e.x==-1005 and e.z==1150,"shifted spawn root handled")
local f=field("TEAM",0,4,0/0,math.huge,-885,260)
check(f.x==-885 and f.z==260,"invalid impact uses real castle fallback")
check(f.corrected,"invalid impact is always corrected")
local g=field("BATTLE_ROYALE",0,4,0/0,-math.huge,nil,nil)
check(g.x==620 and g.z==469,"invalid fallback uses arena center")
local h=field("TEAM",0,4,-1026,-17,-885,260)
check(h.x==-1025 and h.z==-16,"clamp exactly outside inclusive bounds")
local i=field("TEAM",0,4,-1025,-16,-885,260)
check(not i.corrected,"inside protected bounds untouched")
local ok=pcall(function() field("UNKNOWN",0,4,0,0,0,0) end)
check(not ok,"unknown mode rejected")
local ok2=pcall(function() field("TEAM",math.huge,4,0,0,0,0) end)
check(not ok2,"nonfinite world root rejected")
print("EGGRUMBLE_FIELD_EGG_RECOVERY_NATIVE_PASS checks="..tostring(n))
