
check("full_local_receiver_hides_peer_without_touching_availability", function()
    local f = fixture(false)
    f.a.prompt:SetAttribute("EGGRUMBLE_RelayPresentationReceiverReady", false)
    install(f, true)
    hidden(f.b.prompt)
    assert(f.b.prompt.Enabled and f.b.prompt:GetAttribute(READY) and #f.rays == 0)
    f.a.prompt:SetAttribute("EGGRUMBLE_RelayPresentationReceiverReady", true)
    f.update()
    visible(f.b.prompt)
    f.a.prompt:SetAttribute("EGGRUMBLE_RelayPresentationReceiverReady", false)
    f.update()
    hidden(f.b.prompt)
end)
check("donor_cooldown_filters_after_an_engine_enabled_update", function()
    local f = fixture(false)
    f.b.prompt:SetAttribute(READY, false)
    install(f, true)
    hidden(f.b.prompt)
    f.b.prompt.Enabled = false
    f.b.prompt.Enabled = true
    f.update()
    hidden(f.b.prompt)
    f.b.prompt:SetAttribute(READY, true)
    f.update()
    visible(f.b.prompt)
end)
check("receiver_contract_absence_does_not_authorize_the_prompt", function()
    local f = fixture(false)
    f.a.prompt:SetAttribute("EGGRUMBLE_RelayPresentationReceiverReady", nil)
    install(f, true)
    hidden(f.b.prompt)
    assert(f.b.prompt.Enabled and #f.rays == 0)
end)
