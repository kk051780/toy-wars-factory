+-- EGG_RELAY_V1: ONE canonical Game holds ALL egg state; receiver activates
+-- the carried egg's ProximityPrompt. Identity/range/raycast are SERVER-SOURCED.
+-- Only Studio private play for this proof (no live feature or new Remote).
+tryServerEggRelay=function(carrier: Player, receiver: Player)
+    if not RunService:IsStudio() or ServerStorage:GetAttribute("P0D_RC_ENABLE_EGG_RELAY")==false
+        or match.phase~="ACTIVE" or match.serial<1 then return end
+    if carrier==receiver or carrier.Parent~=Players or receiver.Parent~=Players then return end
+    local eggId=carry[carrier]
+    if not eggId or carry[receiver]~=nil then return end
+    local team=getTeamName(carrier)
+    if (team~="RED" and team~="BLUE") or getTeamName(receiver)~=team then return end
+    local aliveA,rootA=healthy(carrier)
+    local aliveB,rootB=healthy(receiver)
+    if not aliveA or not aliveB or not rootA or not rootB
+        or slowed[carrier]~=nil or slowed[receiver]~=nil then return end
+    local fromId=h2Ids[carrier] or carrier.UserId
+    local toId=h2Ids[receiver] or receiver.UserId
+    if type(fromId)~="number" or type(toId)~="number" or fromId<=0 or toId<=0 then return end
+    local actualVersion=relayVersions[eggId] or 0
+    if EXPERIMENTAL_FIVE_EGG_MODE then
+        local egg=h2ScoreState and h2ScoreState.eggs[eggId]
+        local def=h2Eggs[eggId]
+        if not egg or not def or not h2ScoreState.active
+            or egg.state~="CARRIED" or egg.holder~=fromId
+            or def.owner==team then return end
+        actualVersion=egg.transferSeq
+    elseif match.eggOwners[eggId]~=carrier or eggId==team then
+        return
+    end
+    local sourcePos=rootA.Position+Vector3.new(0,1.4,0)
+    local targetPos=rootB.Position+Vector3.new(0,1.4,0)
+    local ray=RaycastParams.new()
+    ray.FilterType=Enum.RaycastFilterType.Exclude
+    ray.FilterDescendantsInstances={carrier.Character,receiver.Character}
+    ray.IgnoreWater=false
+    local blocked=workspace:Raycast(sourcePos,targetPos-sourcePos,ray)~=nil
+    local serverElapsed=math.max(0,serverNow()-match.startedAt)
+    local seq=relayRequestSerial+1
+    local world={
+        phase="PLAYING",roundEpoch=match.serial,nowSec=serverElapsed,
+        lastAcceptedSeqByUser=relayAcceptedSeq,
+        serverLineOfSightClear=not blocked,
+        players={
+            [fromId]={alive=aliveA,stunned=slowed[carrier]~=nil,
+                restrained=slowed[carrier]~=nil,team=team,carriedEggId=eggId,
+                serverPosition={x=rootA.Position.X,y=rootA.Position.Y,z=rootA.Position.Z}},
+            [toId]={alive=aliveB,stunned=slowed[receiver]~=nil,
+                restrained=slowed[receiver]~=nil,team=team,carriedEggId=carry[receiver],
+                serverPosition={x=rootB.Position.X,y=rootB.Position.Y,z=rootB.Position.Z}},
+        },
+        eggs={[eggId]={id=eggId,phase="CARRIED",carrierUserId=fromId,
+            relayEligible=true,transferSeq=actualVersion,lastRelayAtSec=relayLastAt[eggId]}},
+    }
+    local allowed,receipt=EggRelayPolicy.evaluate(world,{
+        actorUserId=fromId,targetUserId=toId,eggId=eggId,seq=seq,
+        roundEpoch=match.serial,expectedTransferSeq=actualVersion,
+    })
+    if not allowed then return end
+    -- End-to-end no-yield recheck; score and carry state are not client-authored.
+    if match.phase~="ACTIVE" or carry[carrier]~=eggId or carry[receiver]~=nil
+        or getTeamName(carrier)~=team or getTeamName(receiver)~=team then return end
+    if EXPERIMENTAL_FIVE_EGG_MODE then
+        local ok=H2Score.relay(h2ScoreState,fromId,toId,team)
+        if not ok then return end
+        if not H2Score.assertConserved(h2ScoreState) then
+            error("EGG_RELAY_H2_CONSERVATION_FAILED")
+        end
+    else
+        if match.eggOwners[eggId]~=carrier then return end
+        match.eggOwners[eggId]=receiver
+        relayVersions[eggId]=receipt.newTransferSeq
+    end
+    -- The single Game owns both views; no extra points, XP, receipts or damage.
+    carry[carrier]=nil
+    carry[receiver]=eggId
+    relayAcceptedSeq[fromId]=receipt.acceptedRequestSeq
+    relayRequestSerial=seq
+    relayLastAt[eggId]=serverElapsed
+    stopWind(receiver)
+    removeCarrierVisual(carrier)
+    giveEggVisual(receiver)
+    broadcast()
+end
+
