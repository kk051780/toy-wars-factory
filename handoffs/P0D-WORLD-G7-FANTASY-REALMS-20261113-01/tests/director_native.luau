-- Real native Luau execution of exactly the source to be shipped. Not Roblox engine simulation.
local D=require("../src/RiftDirector")
local n=0
local function ok(v,msg) assert(v,msg);n+=1 end
local function state(t,seed) return D.state(t,seed or 0) end
ok(D.CYCLE_SECONDS==95,"cycle")
ok(D.WAIT_SECONDS+D.ANNOUNCE_SECONDS+D.ACTIVE_SECONDS+D.COOLDOWN_SECONDS==95,"durations")
ok(state(0).phase=="WAIT","t0 wait")
ok(state(19.999).phase=="WAIT","wait bound")
ok(state(20).phase=="ANNOUNCE","announce starts")
ok(state(24.999).phase=="ANNOUNCE","announce bound")
ok(state(25).phase=="ACTIVE","active starts")
ok(state(49.999).phase=="ACTIVE","active bound")
ok(state(50).phase=="COOLDOWN","cooldown starts")
ok(state(94.999).phase=="COOLDOWN","cooldown bound")
ok(state(95).phase=="WAIT","second cycle")
ok(state(0).realm=="SPACE","round 0 realm")
ok(state(95).realm=="HEAVEN","round 1 realm")
ok(state(190).realm=="ABYSS","round 2 realm")
ok(state(285).realm=="SPACE","round 3 realm")
ok(state(0,1).realm=="HEAVEN","seed 1")
ok(state(0,2).realm=="ABYSS","seed 2")
ok(state(0,3).realm=="SPACE","seed mod3")
ok(state(25).field_id=="WF-13","space source")
ok(state(120).field_id=="WF-14","heaven source")
ok(state(215).field_id=="WF-15","abyss source")
ok(state(25).source_only==true,"no game")
ok(state(25).world_access_is_free==true,"free access")
ok(state(25).server_gameplay_bonus==false,"no bonus")
ok(state(25).permanent_ground_route_open==true,"always open")
ok(state(0).remaining==20,"wait remaining")
ok(state(20).remaining==5,"announce remaining")
ok(state(25).remaining==25,"active remaining")
ok(state(50).remaining==45,"cooldown remaining")
ok(D.isSymmetric("RED","BLUE"),"sym red")
ok(D.isSymmetric("BLUE","RED"),"sym blue")
ok(not D.isSymmetric("RED","RED"),"reject same team")
ok(not D.isSymmetric("GREEN","BLUE"),"reject unknown team")
ok(D.safeForCarrier(true),"carrier may enter showroom")
ok(D.safeForCarrier(false),"free roam")
ok(not D.safeForCarrier(nil),"no unknown carrying")
ok(not D.safeForCarrier("yes"),"no forged flag")
ok(D.state(-1,0)==nil,"negative elapsed")
ok(D.state("25",0)==nil,"string elapsed")
ok(D.state(0/0,0)==nil,"NaN elapsed")
ok(D.state(1e100,0)==nil,"huge elapsed")
ok(D.state(10,-1)==nil,"negative seed")
ok(D.state(10,1.25)==nil,"noninteger seed")
ok(D.state(10,"0")==nil,"string seed")
ok(D.state(10,0/0)==nil,"NaN seed")
ok(D.state(10,100000000)==nil,"huge seed")
print("P0D_WORLD_G7_REAL_NATIVE_DIRECTOR_PASS assertions="..tostring(n))
