-- TRAP RAIDERS D14 standalone SERVER-side raft movement core.
-- IMPORTANT: all server context and waterCheck inputs MUST come from genuine server facts.
-- Intents only; does not change occupant Humanoid, physics or any other live source.
local M = {}
local MAX_XZ = 2048
local MAX_SPEED = 8 -- studs / s, conservative map-agnostic baseline
local ACCEL = 12 -- studs / s^2
local TURN = math.rad(75) -- radians / s
local MAX_DT = 200 -- ms / step
local MAX_TRAVEL = 1.7 -- studs /step
local EPS = 1e-6

local function finite(n)
    return type(n) == "number" and n == n and n > -math.huge and n < math.huge
end
local function validId(s)
    return type(s) == "string" and #s >= 1 and #s <= 96 and string.match(s, "^[%w_.%-]+$") ~= nil
end
local function validPos(x, z)
    return finite(x) and finite(z) and math.abs(x) <= MAX_XZ and math.abs(z) <= MAX_XZ
end
local function validAngle(a)
    return finite(a) and math.abs(a) <= math.pi * 8
end
local function trimAngle(a)
    return (a + math.pi) % (math.pi * 2) - math.pi
end
local function copy(s)
    return {roundId=s.roundId,raftId=s.raftId,stage=s.stage,driverId=s.driverId,
        seatEpoch=s.seatEpoch,x=s.x,z=s.z,y=s.y,yaw=s.yaw,speed=s.speed,
        seq=s.seq,lastMs=s.lastMs,active=s.active,closed=s.closed}
end
local function answer(s, verdict)
    return copy(s), verdict
end

function M.new(roundId, raftId, stage, x, y, z, yaw, serverMs)
    if not validId(roundId) or not validId(raftId) or (stage ~= 1 and stage ~= 2)
        or not validPos(x,z) or not finite(y) or math.abs(y)>2048 or not validAngle(yaw)
        or not finite(serverMs) or serverMs < 0 then
        return nil, "BAD_START"
    end
    return {roundId=roundId, raftId=raftId, stage=stage, driverId=nil,seatEpoch=0,
        x=x,z=z,y=y,yaw=trimAngle(yaw),speed=0,seq=0,lastMs=serverMs,active=false,closed=false}, "OK"
end

-- Server sees the actual D14 seat owner, never client supplied occupancy.
-- An epoch update revokes all prior controls. Epochs must monotonically increase.
function M.bindDriver(s, roundId, driverId, seatEpoch, serverMs)
    if s.closed or roundId ~= s.roundId or not finite(serverMs) or serverMs < s.lastMs
        or type(seatEpoch) ~= "number" or seatEpoch % 1 ~= 0
        or seatEpoch <= s.seatEpoch or seatEpoch > 2147483647 then
        return answer(s, "DENY_BIND")
    end
    if driverId ~= nil and not validId(driverId) then return answer(s, "DENY_DRIVER") end
    local n=copy(s)
    n.driverId=driverId
    n.seatEpoch=seatEpoch
    n.speed=0
    n.active=driverId ~= nil
    n.seq=0
    n.lastMs=serverMs
    return n, "BOUND"
end

-- trusted is generated by the server integration from D01 and D14, NOT from a RemoteEvent payload.
-- waterCheck(x,z,stage,raftId) must validate grounded source-map water AND safe route.
function M.step(s, roundId, driverId, seatEpoch, seq, throttle, steer, serverMs, trusted, waterCheck)
    if s.closed or not s.active or roundId~=s.roundId or driverId~=s.driverId
        or seatEpoch~=s.seatEpoch then return answer(s,"DENY_AUTH") end
    if type(seq)~="number" or seq%1~=0 or seq<=s.seq or seq>2147483647
        or not finite(serverMs) or serverMs<s.lastMs or serverMs-s.lastMs>MAX_DT
        or not finite(throttle) or not finite(steer) or math.abs(throttle)>1 or math.abs(steer)>1 then
        return answer(s,"DENY_INPUT")
    end
    if type(trusted)~="table" or trusted.roundId~=s.roundId
        or trusted.driverId~=s.driverId or trusted.seatEpoch~=s.seatEpoch
        or trusted.stage~=s.stage or trusted.alive~=true or trusted.seated~=true
        or trusted.sameTeam~=true or trusted.eggCarrier~=false or trusted.snared~=false
        or trusted.rewinding~=false or type(waterCheck)~="function" then
        return answer(s,"DENY_SERVER_FACTS")
    end
    local dt=(serverMs-s.lastMs)/1000
    local n=copy(s)
    n.lastMs=serverMs
    n.seq=seq
    -- braking even while steer input present; reverse limited to -3 studs/s.
    local desired = throttle >= 0 and throttle*MAX_SPEED or throttle*3
    local delta=math.clamp(desired-n.speed,-ACCEL*dt,ACCEL*dt)
    n.speed=math.clamp(n.speed+delta,-3,MAX_SPEED)
    n.yaw=trimAngle(n.yaw+steer*TURN*dt)
    local dx=math.sin(n.yaw)*n.speed*dt
    local dz=math.cos(n.yaw)*n.speed*dt
    if (dx*dx+dz*dz)>MAX_TRAVEL*MAX_TRAVEL+EPS then return answer(s,"DENY_TRAVEL") end
    local mx,mz=s.x+dx*0.5,s.z+dz*0.5
    local nx,nz=s.x+dx,s.z+dz
    if not validPos(nx,nz) then
        n.speed=0
        return n,"BLOCK_BOUNDS"
    end
    local ok1,res1=pcall(waterCheck,mx,mz,s.stage,s.raftId)
    local ok2,res2=pcall(waterCheck,nx,nz,s.stage,s.raftId)
    if not ok1 or not ok2 or res1~=true or res2~=true then
        n.speed=0
        return n,"BLOCK_WATER"
    end
    n.x,n.z=nx,nz
    return n,"MOVE_OK"
end

function M.close(s, roundId)
    if roundId~=s.roundId then return answer(s,"DENY_ROUND") end
    local n=copy(s)
    n.closed=true
    n.active=false
    n.driverId=nil
    n.speed=0
    return n,"CLOSED"
end
function M.snapshot(s)
    return {roundId=s.roundId,raftId=s.raftId,stage=s.stage,x=s.x,y=s.y,z=s.z,
        yaw=s.yaw,speed=s.speed,seq=s.seq,seatEpoch=s.seatEpoch,active=s.active and not s.closed}
end
return M
