+-- These replicated attributes are sourced from a successful canonical Store load
+-- or acknowledged UpdateAsync only. They never trust client or preview attributes.
+local function publishV4Canonical(player: Player)
+    if player.Parent~=Players then return end
+    local record=persistentProfiles[player]
+    if persistenceState[player]~="SAVED" or not record
+        or not PersistentHatch.validate(record) then
+        player:SetAttribute("P0D_V4_SaveStatus","LOCAL_ONLY")
+        return
+    end
+    local v4=record.trainingV4
+    if v4==nil then
+        player:SetAttribute("P0D_V4_SaveStatus","READY_TO_TRAIN")
+        player:SetAttribute("P0D_V4_SavedRemaining",1800)
+        player:SetAttribute("P0D_V4_SavedMode","RANDOM")
+        player:SetAttribute("P0D_V4_SavedSkill","-")
+        return
+    end
+    if type(v4.totalsMicro)~="table" or type(v4.focusedSeconds)~="number" then
+        player:SetAttribute("P0D_V4_SaveStatus","INVALID_PROFILE")
+        return
+    end
+    -- Use the original exact author XP level curve to view stored MICRO XP.
+    for _,skill in ipairs(V4XP.SKILLS) do
+        local micro=v4.totalsMicro[skill]
+        local lv=V4XP.viewXP(micro)
+        if lv.valid then
+            player:SetAttribute("P0D_V4_SAVED_"..skill.."_LV",lv.level)
+            player:SetAttribute("P0D_V4_SAVED_"..skill.."_XP",lv.xp)
+            player:SetAttribute("P0D_V4_SAVED_"..skill.."_NEXT",lv.xpToNext)
+        else
+            player:SetAttribute("P0D_V4_SaveStatus","INVALID_PROFILE")
+            return
+        end
+    end
+    -- When a new JST day begins, old focusedSeconds is not yet reset until next grant.
+    local jstDay=math.floor((os.time()+32400)/86400)
+    local used=if v4.dayIndex==jstDay then v4.focusedSeconds else 0
+    player:SetAttribute("P0D_V4_SavedRemaining",math.max(0,1800-used))
+    local seed=PersistentHatch.policyUserId(player.UserId)
+    if seed~=nil then
+        local active=V4Scheduler.newState(seed,os.time(),v4)
+        local status=V4Scheduler.getStatus(active,false)
+        player:SetAttribute("P0D_V4_SavedMode",status.mode)
+        player:SetAttribute("P0D_V4_SavedSkill",status.skill)
+    end
+    player:SetAttribute("P0D_V4_SaveStatus","SAVED")
+end
