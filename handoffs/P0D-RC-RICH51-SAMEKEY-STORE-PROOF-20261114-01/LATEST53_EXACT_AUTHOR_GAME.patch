+-- V4 six-skill durable ticket: minted by the ORIGINAL Game; no Remote and no
+-- concurrent background Store writer. Studio-only DEV key until Owner approves public.
+local v4Locations={
+    BEAST={56,-15},WEAPON={56,15},
+    MAGIC={54,-49},ZOMBIE={54,49},
+    VEHICLE={74,-49},BUILDING={74,49},
+}
+local function v4OnHomePad(player: Player): string?
+    if match.phase=="RESULTS" or carry[player]~=nil then return nil end
+    local alive,root=healthy(player)
+    local team=getTeamName(player)
+    if not alive or not root or (team~="RED" and team~="BLUE") then return nil end
+    if math.abs(root.Position.Y-1)>10 then return nil end
+    local sign=if team=="RED" then -1 else 1
+    for _,skill in ipairs(V4XP.SKILLS) do
+        local coord=v4Locations[skill]
+        local dx=root.Position.X-sign*coord[1]
+        local dz=root.Position.Z-coord[2]
+        if dx*dx+dz*dz<=25 then return skill end
+    end
+    return nil
+end
+local function v4VerifiedFriends(player: Player): number
+    local count=0
+    local record=dojoFriends[player]
+    if record==nil then return 0 end
+    for _,other in ipairs(Players:GetPlayers()) do
+        if other~=player and other.UserId>0 and record[other.UserId]==true then
+            count+=1
+        end
+    end
+    return math.min(count,4)
+end
+local function v4SaveOneWindow(player: Player,skill: string,utcStart: number,utcEnd: number)
+    if v4SavePending[player] or not canWriteProfile(player) then return end
+    -- Trust ONLY server-side pad and same-key Game's friend verification.
+    if v4OnHomePad(player)~=skill or utcEnd-utcStart<30
+        or utcEnd-utcStart>120 or utcEnd>os.time()+2 then return end
+    local startDay=math.floor((utcStart+32400)/86400)
+    local endDay=math.floor((utcEnd+32400)/86400)
+    if startDay~=endDay then return end -- split at JST midnight, never cross-day award
+    v4ReceiptSerial+=1
+    local receipt="T"..hatchSessionGUID..":"..tostring(v4ReceiptSerial)
+    local ticket={receipt=receipt,utcStart=utcStart,utcEnd=utcEnd,
+        friendCount=v4VerifiedFriends(player),selectedSkill=skill,
+        verifiedByCanonicalGame=true}
+    v4SavePending[player]=true
+    outstandingWrites+=1
+    player:SetAttribute("P0D_V4_SaveStatus","WRITING")
+    task.spawn(function()
+        local acknowledged=false
+        local updated=nil
+        -- UpdateAsync can commit even when the response is lost: retry SAME token.
+        for attempt=1,3 do
+            if studioHatchStore==nil or player.UserId<=0 then break end
+            local ok,record=PersistentHatch.settleSixSkill(studioHatchStore,player.UserId,ticket)
+            if ok and record then acknowledged=true;updated=record;break end
+            if attempt<3 then task.wait(attempt*.5) end
+        end
+        if acknowledged and updated and player.Parent==Players then
+            local previous=persistentProfiles[player]
+            if previous==nil or updated.revision>=previous.revision then
+                persistentProfiles[player]=updated
+            end
+            publishV4Canonical(player)
+        elseif player.Parent==Players then
+            player:SetAttribute("P0D_V4_SaveStatus","UNCONFIRMED")
+            warn("P0D_V4_SAVED_XP_NOT_CONFIRMED",player.UserId)
+        end
+        v4SavePending[player]=nil
+        outstandingWrites-=1
+    end)
+end
+local function v4TickCanonical()
+    if not RunService:IsStudio() then return end
+    local utcNow=os.time()
+    for _,player in ipairs(Players:GetPlayers()) do
+        local skill=v4OnHomePad(player)
+        if not canWriteProfile(player) or skill==nil then
+            v4WindowStart[player]=nil
+            v4WindowSkill[player]=nil
+        elseif v4WindowSkill[player]~=skill or v4WindowStart[player]==nil then
+            v4WindowSkill[player]=skill
+            v4WindowStart[player]=utcNow
+        elseif utcNow-v4WindowStart[player]>=30 and not v4SavePending[player] then
+            local start=v4WindowStart[player]
+            -- Never award a batch crossing local midnight; restart new day window.
+            if math.floor((start+32400)/86400)~=math.floor((utcNow+32400)/86400) then
+                v4WindowStart[player]=utcNow
+            else
+                v4WindowStart[player]=utcNow
+                v4SaveOneWindow(player,skill,start,utcNow)
+            end
+        end
+    end
+end
 
