{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P0D World Rare Fantasy Atlas V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "game_id",
    "work_id",
    "packet_id",
    "language",
    "status",
    "source_issue",
    "existing_cards",
    "principles",
    "sources",
    "worlds",
    "mechanics",
    "neutral_npcs",
    "measurement",
    "governance"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "game_id": {
      "const": "TRAP_RAIDERS"
    },
    "work_id": {
      "type": "string"
    },
    "packet_id": {
      "type": "string"
    },
    "language": {
      "const": "ja-JP"
    },
    "status": {
      "const": "DESIGN_ONLY"
    },
    "source_issue": {
      "type": "string"
    },
    "existing_cards": {
      "type": "string"
    },
    "principles": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "url",
          "kind",
          "observation"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          }
        }
      }
    },
    "worlds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "look",
          "gameplay",
          "neutrals",
          "access",
          "rarity",
          "phase"
        ],
        "properties": {
          "id": {
            "enum": [
              "SPACE",
              "CELESTIAL",
              "EMBER",
              "ECLIPSE"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "look": {
            "type": "string"
          },
          "gameplay": {
            "type": "string"
          },
          "neutrals": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "access": {
            "type": "string"
          },
          "rarity": {
            "type": "string"
          },
          "phase": {
            "const": "DESIGN_ONLY"
          }
        }
      }
    },
    "mechanics": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "world_id",
          "name",
          "kind",
          "child_one_action",
          "three_second_cue",
          "gameplay_meaning",
          "job_item_tactic",
          "counterplay",
          "marketing_hook_7s",
          "marketing_script_15s",
          "H0",
          "H1",
          "rollback",
          "perf_budget",
          "phase",
          "requires_real_studio"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WF-(1[3-9]|2[0-4])$"
          },
          "world_id": {
            "enum": [
              "SPACE",
              "CELESTIAL",
              "EMBER",
              "ECLIPSE"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "kind": {
            "type": "string"
          },
          "child_one_action": {
            "type": "string",
            "minLength": 4
          },
          "three_second_cue": {
            "type": "string",
            "minLength": 4
          },
          "gameplay_meaning": {
            "type": "string",
            "minLength": 4
          },
          "job_item_tactic": {
            "type": "string",
            "minLength": 4
          },
          "counterplay": {
            "type": "string",
            "minLength": 4
          },
          "marketing_hook_7s": {
            "type": "string",
            "minLength": 4
          },
          "marketing_script_15s": {
            "type": "string",
            "minLength": 4
          },
          "H0": {
            "type": "string",
            "minLength": 4
          },
          "H1": {
            "type": "string",
            "minLength": 4
          },
          "rollback": {
            "type": "string",
            "minLength": 4
          },
          "perf_budget": {
            "type": "string",
            "minLength": 4
          },
          "phase": {
            "const": "DESIGN_ONLY"
          },
          "requires_real_studio": {
            "const": true
          }
        }
      }
    },
    "neutral_npcs": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "world_id",
          "name",
          "appearance",
          "player_cue",
          "spawn_rule",
          "role",
          "fairness",
          "canon_id",
          "phase"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "world_id": {
            "enum": [
              "SPACE",
              "CELESTIAL",
              "EMBER",
              "ECLIPSE"
            ]
          },
          "name": {
            "type": "string"
          },
          "appearance": {
            "type": "string"
          },
          "player_cue": {
            "type": "string"
          },
          "spawn_rule": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "fairness": {
            "type": "string"
          },
          "canon_id": {
            "const": "UNASSIGNED_D18_COMPAT_REVIEW_REQUIRED"
          },
          "phase": {
            "const": "DESIGN_ONLY"
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "required": [
        "first60_action",
        "rare_world_exposure",
        "neutral_encounter_rate",
        "match_completion",
        "voluntary_rematch",
        "mobile_fps",
        "revenue"
      ]
    },
    "governance": {
      "type": "object",
      "required": [
        "real_game_adoption_count",
        "Studio",
        "global_release_score_authority",
        "S1_release_blocker",
        "permissions"
      ],
      "properties": {
        "real_game_adoption_count": {
          "const": 0
        },
        "Studio": {
          "const": "NOT_TESTED"
        },
        "S1_release_blocker": {
          "const": false
        },
        "global_release_score_authority": {
          "const": "#220 solely"
        },
        "permissions": {
          "type": "string"
        }
      }
    }
  }
}
