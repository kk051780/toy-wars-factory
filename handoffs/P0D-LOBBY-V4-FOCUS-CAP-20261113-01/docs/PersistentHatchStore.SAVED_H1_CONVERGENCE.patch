+-- REVIEW ONLY: retained exactly one canonical Store key and one UpdateAsync writer.
+-- Install exclusively in original Store-owner's isolated Game after product review.
+-- Immutable receipt fields must be minted from verified ORIGINAL Game training ticks.
+function Store.settleSixSkill(store:any,uid:any,canonicalGrant:any)
+    local key=userKey(uid)
+    if not key or not store or type(canonicalGrant)~="table" then
+        return false,nil,"INVALID_STORE_OR_GRANT" end
+    local ticket={
+        receipt=canonicalGrant.receipt,
+        utcStart=canonicalGrant.utcStart,
+        utcEnd=canonicalGrant.utcEnd,
+        friendCount=canonicalGrant.friendCount,
+        selectedSkill=canonicalGrant.selectedSkill,
+        verifiedByCanonicalGame=canonicalGrant.verifiedByCanonicalGame,
+    }
+    local ok,updated=pcall(function()
+        return store:UpdateAsync(key,function(original)
+            local nextRecord=normalized(original)
+            if not nextRecord then return nil end
+            local six,status=SixSkill.settle(nextRecord.trainingV4,uid,ticket)
+            if not six then return nil end
+            if status=="ALREADY_SETTLED" then return nextRecord end
+            nextRecord.trainingV4=six
+            nextRecord.revision+=1
+            if not Store.validate(nextRecord) then return nil end
+            return nextRecord
+        end)
+    end)
+    if not ok or not Store.validate(updated) or not updated.trainingV4
+        or type(updated.trainingV4.receipts)~="table"
+        or updated.trainingV4.receipts[ticket.receipt]~=true then
+        return false,nil,"TRAINING_WRITE_NOT_CONFIRMED"
+    end
+    return true,updated,"PERSISTED_OR_ALREADY_SETTLED"
+end
 return Store
