-- Execute actual shipped policy on native Luau VM; not Roblox physics.
local R=require("../src/G8TravelRules")
local c=0
local function yes(value,label) assert(value,label);c+=1 end
local function valid(a,b,d,last,now,h)
 return R.validate(a,b,d or 0,last or -100,now or 5,h or 100)
end
yes(R.MAX_DISTANCE_SQUARED==196,"real distance guard")
yes(R.COOLDOWN==1.6,"real cooldown")
yes(valid("PORT","SEA"),"PORT SEA")
yes(valid("SEA","PORT"),"SEA PORT")
yes(valid("SEA","SKY"),"SEA SKY")
yes(valid("SKY","SEA"),"SKY SEA")
yes(valid("SKY","PORT"),"SKY PORT")
local g,e=valid("PORT","SKY")
yes(g==false and e=="NO_ROUTE","forbid unlisted PORT SKY")
g,e=valid("PORT","PORT")
yes(g==false and e=="NO_ROUTE","forbid same")
g,e=valid("RED","SEA")
yes(g==false and e=="NO_ROUTE","forbid RED as node")
g,e=R.validate(nil,"SEA",10,-100,5,100)
yes(g==false and e=="BAD_NODE","reject nil node")
g,e=R.validate("PORT",nil,10,-100,5,100)
yes(g==false and e=="BAD_NODE","reject nil dest")
g,e=R.validate("PORT","SEA",-1,-100,5,100)
yes(g==false and e=="TOO_FAR","negative dist")
g,e=R.validate("PORT","SEA",197,-100,5,100)
yes(g==false and e=="TOO_FAR","too far")
yes(R.validate("PORT","SEA",196,-100,5,100),"exact boundary")
g,e=R.validate("PORT","SEA",0,5,5.2,100)
yes(g==false and e=="COOLDOWN","replay")
yes(R.validate("PORT","SEA",0,5,6.7,100),"past cooldown")
g,e=R.validate("PORT","SEA",0,10,7,100)
yes(g==false and e=="INVALID_CLOCK","future last")
g,e=R.validate("PORT","SEA",0,-100,-1,100)
yes(g==false and e=="INVALID_CLOCK","negative clock")
g,e=R.validate("PORT","SEA",0,-100,5,0)
yes(g==false and e=="NOT_ALIVE","dead")
g,e=R.validate("PORT","SEA",0,-100,5,-12)
yes(g==false and e=="NOT_ALIVE","negative health")
g,e=R.validate("PORT","SEA","0",-100,5,100)
yes(g==false and e=="TOO_FAR","string dist")
g,e=R.validate("PORT","SEA",0/0,-100,5,100)
yes(g==false and e=="TOO_FAR","nan dist")
g,e=R.validate("PORT","SEA",1e100,-100,5,100)
yes(g==false and e=="TOO_FAR","huge dist")
g,e=R.validate("PORT","SEA",0,nil,5,100)
yes(g==false and e=="INVALID_CLOCK","missing last")
g,e=R.validate("PORT","SEA",0,-100,nil,100)
yes(g==false and e=="INVALID_CLOCK","missing now")
g,e=R.validate("PORT","SEA",0,-100,5,nil)
yes(g==false and e=="NOT_ALIVE","missing health")
g,e=R.validate("PORT","SEA",0,-100,5,0/0)
yes(g==false and e=="NOT_ALIVE","nan health")
g,e=R.validate("PORT","SEA",0,-100,5,1e100)
yes(g==false and e=="NOT_ALIVE","huge health")
local p=R.destination("PORT")
yes(p and p.x==0 and p.y==5 and p.z==0,"PORT safe landing")
p=R.destination("SEA")
yes(p and p.x==0 and p.y==-23 and p.z==150,"SEA safe landing")
p=R.destination("SKY")
yes(p and p.x==0 and p.y==53 and p.z==300,"SKY safe landing")
yes(R.destination("OTHER")==nil,"bad destination")
yes(R.destination(nil)==nil,"nil destination")
yes(R.symmetricAccess("RED"),"red free")
yes(R.symmetricAccess("BLUE"),"blue free")
yes(R.symmetricAccess("NONE"),"neutral free")
yes(not R.symmetricAccess("GREEN"),"unknown team")
yes(not R.symmetricAccess(nil),"nil team")
yes(R.ALLOWED.PORT.SEA==true,"port graph")
yes(R.ALLOWED.SEA.PORT==true,"sea emergency")
yes(R.ALLOWED.SKY.PORT==true,"sky emergency")
yes(R.ALLOWED.SEA.SKY==true,"sea sky")
yes(R.ALLOWED.SKY.SEA==true,"sky sea")
print("P0D_WORLD_G8_REAL_NATIVE_SECURE_TRAVEL_POLICY_PASS assertions="..tostring(c))
