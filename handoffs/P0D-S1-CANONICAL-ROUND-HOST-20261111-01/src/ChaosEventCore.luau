--!strict
-- TRAP RAIDERS v40+v41 / pure server-side decision reference.
-- Does not spawn parts, mutate gameplay, play audio or trust client input.
local Core = {}
local WEATHER = { "WX01_METEOR", "WX02_SMALL", "WX03_CROWN", "WX04_GLIDE", "WX05_CLOCK" }
local WEATHER_WEIGHTS = { 4, 2, 2, 1, 1 }
local BOSS_BY_STAGE = { S1 = "GOROGAN", S2 = "RAIGALD", S3 = "GOROGAN", S4 = "RAIGALD" }

local function finite(value): boolean
    return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end
local function safeId(value): boolean
    return type(value) == "string" and #value > 0 and #value <= 96 and string.match(value, "^[%w_%-]+$") ~= nil
end

function Core.new(matchId: string, stage: string, startedAt: number)
    assert(safeId(matchId), "MATCH_ID_INVALID")
    assert(BOSS_BY_STAGE[stage] ~= nil, "STAGE_INVALID")
    assert(finite(startedAt) and startedAt >= 0, "TIME_INVALID")
    return {matchId=matchId, stage=stage, startedAt=startedAt, lastAt=startedAt,
        decided=false, kind="NONE", subtype="NONE", phase="WAIT", warningEnd=nil,
        activeEnd=nil, eventsSent=0, finished=false}
end

-- Roll is an integer 0..99 generated by the trusted match server, not RemoteEvent.
function Core.classify(roll: number, stage: string): (string, string)
    assert(finite(roll) and roll % 1 == 0 and roll >= 0 and roll < 100, "ROLL_INVALID")
    assert(BOSS_BY_STAGE[stage] ~= nil, "STAGE_INVALID")
    if roll < 65 then return "NORMAL", "NONE" end
    if roll < 90 then return "BOSS", BOSS_BY_STAGE[stage] end
    local w = roll - 90
    for i, weight in ipairs(WEATHER_WEIGHTS) do
        if w < weight then return "WEATHER", WEATHER[i] end
        w -= weight
    end
    error("WEATHER_CLASSIFY_FAILED")
end

local function weatherDuration(subtype: string): number
    if subtype == "WX02_SMALL" then return 7 end
    if subtype == "WX03_CROWN" then return 8 end
    if subtype == "WX04_GLIDE" then return 6 end
    if subtype == "WX05_CLOCK" then return 6 end
    return 5 -- meteor warning shown before this impact window
end

-- `now` and `matchDeadline` are authoritative monotonic server seconds.
-- Insufficient time resolves to NORMAL permanently (no repeated RNG farming).
function Core.advance(state, now: number, matchDeadline: number, roll: number?, matchActive: boolean)
    assert(finite(now) and finite(matchDeadline) and now >= state.lastAt, "TIME_NON_MONOTONIC")
    if state.finished then return state, nil end
    state.lastAt = now
    if not matchActive or now >= matchDeadline then
        state.finished, state.phase = true, "DONE"
        return state, {event="CLEANUP", matchId=state.matchId}
    end
    if state.decided == false then
        if now - state.startedAt < 20 then return state, nil end
        if matchDeadline - now < 19 then
            state.decided, state.kind, state.phase = true, "NORMAL", "DONE"
            return state, nil
        end
        assert(roll ~= nil, "SERVER_ROLL_REQUIRED")
        local kind, subtype = Core.classify(roll :: number, state.stage)
        state.decided, state.kind, state.subtype = true, kind, subtype
        if kind == "NORMAL" then
            state.phase = "DONE"
            return state, nil
        end
        local warning = kind == "BOSS" and 2.5 or 2
        local duration = kind == "BOSS" and 17 or weatherDuration(subtype)
        if matchDeadline - now < warning + duration + 0.5 then
            state.kind, state.subtype, state.phase = "NORMAL", "NONE", "DONE"
            return state, nil
        end
        state.phase, state.warningEnd, state.activeEnd = "TELEGRAPH", now + warning, now + warning + duration
        state.eventsSent += 1
        return state, {event="WARNING", matchId=state.matchId, kind=kind, subtype=subtype,
            untilAt=state.warningEnd, reducedMotionSafe=true, noForcedCamera=true}
    end
    if state.phase == "TELEGRAPH" and now >= state.warningEnd then
        state.phase, state.eventsSent = "ACTIVE", state.eventsSent + 1
        return state, {event="ACTIVATE", matchId=state.matchId, kind=state.kind,
            subtype=state.subtype, untilAt=state.activeEnd, cosmeticOrServerValidated=true}
    end
    if state.phase == "ACTIVE" and now >= state.activeEnd then
        state.phase, state.eventsSent = "DONE", state.eventsSent + 1
        return state, {event="CLEANUP", matchId=state.matchId, kind=state.kind}
    end
    return state, nil
end

return Core
