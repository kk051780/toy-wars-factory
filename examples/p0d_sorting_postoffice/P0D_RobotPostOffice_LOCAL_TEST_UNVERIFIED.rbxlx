<?xml version="1.0" encoding="utf-8"?>
<roblox version="4"><External>null</External><External>nil</External><Item class="Workspace" referent="RBX00000000000000000000000000000001"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="ServerScriptService" referent="RBX00000000000000000000000000000002"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000000000000000000000000000003"><Properties><string name="Name">P0D_RobotPostOfficeTrial</string><ProtectedString name="Source">-- P0-D route A: original non-production one-minute sorting prototype.
-- Install only as a Script in ServerScriptService of a backed-up isolated Studio place.
-- Never install in the Toy Wars production place.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService = game:GetService("RunService")

-- Defense-in-depth only. The owner/Windows Codex must still verify the exact
-- Studio instance and isolated file BEFORE installing this script; PlaceId=0
-- cannot distinguish two different local files.
if not RunService:IsStudio() or game.PlaceId ~= 0 or game.GameId ~= 0 then
    error("P0D_BLOCKED_NOT_UNPUBLISHED_LOCAL_STUDIO")
end
if script.Parent ~= ServerScriptService then
    error("P0D_BLOCKED_WRONG_SCRIPT_CONTAINER")
end
for _, child in ipairs(ServerScriptService:GetChildren()) do
    if child ~= script then
        error("P0D_BLOCKED_OTHER_SERVER_SCRIPTS_PRESENT")
    end
end
-- Validate all non-character objects, not only their top-level names.
-- Default Baseplate and SpawnLocation may have a Texture/Decal decoration.
-- Unknown subtrees and duplicate default roots fail closed.
local allowedRoot = {
    Camera = {className = "Camera", childTypes = {}},
    Terrain = {className = "Terrain", childTypes = {}},
    Baseplate = {className = "Part", childTypes = {Texture = true, Decal = true}},
    SpawnLocation = {className = "SpawnLocation", childTypes = {Texture = true, Decal = true}},
}
local seenRoot = {}
local function isActivePlayerCharacter(child)
    if not child:IsA("Model") then return false end
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character == child then return true end
    end
    return false
end
for _, child in ipairs(Workspace:GetChildren()) do
    if not isActivePlayerCharacter(child) then
        local rule = allowedRoot[child.Name]
        if not rule or child.ClassName ~= rule.className or seenRoot[child.Name] then
            error("P0D_BLOCKED_NONEMPTY_WORKSPACE: " .. child.Name)
        end
        seenRoot[child.Name] = true
        for _, descendant in ipairs(child:GetDescendants()) do
            if descendant.Parent ~= child or not rule.childTypes[descendant.ClassName] then
                error("P0D_BLOCKED_UNEXPECTED_WORKSPACE_DESCENDANT: " .. descendant.Name)
            end
        end
    end
end

local ROOT_NAME = "P0D_RobotPostOffice_TrialOnly"
if Workspace:FindFirstChild(ROOT_NAME) then
    error("P0-D demo already exists; refusing a duplicate world")
end

local world = Instance.new("Model")
world.Name = ROOT_NAME
world.Parent = Workspace
local sessions = {}

local colors = {
    {id = "RED", rgb = Color3.fromRGB(234, 82, 87), x = -12},
    {id = "BLUE", rgb = Color3.fromRGB(75, 155, 238), x = 0},
    {id = "YELLOW", rgb = Color3.fromRGB(242, 204, 78), x = 12},
}

local function makePart(name, size, position, tint, parent)
    local p = Instance.new("Part")
    p.Name = name
    p.Anchored = true
    p.Size = size
    p.Position = position
    p.Color = tint
    p.Material = Enum.Material.SmoothPlastic
    p.Parent = parent
    return p
end

local function addSign(part, text, size)
    local gui = Instance.new("BillboardGui")
    gui.Name = "VisibleLabel"
    gui.Size = UDim2.fromOffset(size, 52)
    gui.StudsOffset = Vector3.new(0, part.Size.Y / 2 + 2.5, 0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 90
    gui.Parent = part
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundColor3 = Color3.fromRGB(27, 34, 49)
    label.BackgroundTransparency = 0.15
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Text = text
    label.Parent = gui
end

local function isAuthorizedInteraction(player, part, detector)
    if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players then
        return false
    end
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    return root ~= nil and root:IsA("BasePart") and
        (root.Position - part.Position).Magnitude &lt;= detector.MaxActivationDistance
end

local function addClick(part, onClick)
    local detector = Instance.new("ClickDetector")
    detector.MaxActivationDistance = 42
    detector.Parent = part
    detector.MouseClick:Connect(function(player)
        if not isAuthorizedInteraction(player, part, detector) then return end
        onClick(player)
    end)
end

local function ensureHUD(player)
    local playerGui = player:WaitForChild("PlayerGui")
    local old = playerGui:FindFirstChild("P0D_RobotPostOfficeHUD")
    if old then return old:FindFirstChild("Objective") end
    local gui = Instance.new("ScreenGui")
    gui.Name = "P0D_RobotPostOfficeHUD"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = false
    gui.Parent = playerGui
    local objective = Instance.new("TextLabel")
    objective.Name = "Objective"
    objective.Size = UDim2.new(0.86, 0, 0, 92)
    objective.AnchorPoint = Vector2.new(0.5, 0)
    objective.Position = UDim2.new(0.5, 0, 0, 70)
    objective.BackgroundColor3 = Color3.fromRGB(24, 39, 58)
    objective.BackgroundTransparency = 0.12
    objective.TextColor3 = Color3.new(1, 1, 1)
    objective.Font = Enum.Font.GothamBold
    objective.TextScaled = true
    objective.TextWrapped = true
    local textLimit = Instance.new("UITextSizeConstraint")
    textLimit.MaxTextSize = 26
    textLimit.MinTextSize = 12
    textLimit.Parent = objective
    objective.Text = "ROBOT POST OFFICE / SORT 3 PARCELS"
    objective.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = objective
    return objective
end

local function show(player, message)
    local session = sessions[player]
    if not session then return end
    local ui = session.objective
    if ui and ui.Parent then
        ui.Text = "ROBOT POST OFFICE | " .. tostring(session.count) .. "/3\n" .. message
    end
end

local function selectParcel(player, colorId)
    local state = sessions[player]
    if not state then return end
    if state.count &gt;= 3 then
        show(player, "Finished! Click green REPLAY pillar.")
        return
    end
    if state.delivered[colorId] then
        state.selected = nil
        show(player, "That parcel is already delivered. Pick another color.")
        return
    end
    state.selected = colorId
    show(player, "Selected " .. colorId .. ". Click the MATCHING bin.")
end

local function deliver(player, binId)
    local state = sessions[player]
    if not state then return end
    if state.count &gt;= 3 then
        show(player, "Finished! Click green REPLAY pillar.")
    elseif not state.selected then
        show(player, "Click a parcel first, then its matching bin.")
    elseif state.selected ~= binId then
        show(player, "Wrong bin: try again. Your parcel is still selected.")
    elseif state.delivered[state.selected] then
        state.selected = nil
        show(player, "That parcel was delivered already. Pick a new color.")
    else
        state.delivered[state.selected] = true
        state.count = state.count + 1
        state.selected = nil
        if state.count == 3 then
            show(player, "Delivered 3/3! Click green REPLAY pillar.")
        else
            show(player, "Delivered! Choose the next parcel.")
        end
    end
end

local function replay(player)
    local state = sessions[player]
    if not state then return end
    if state.count ~= 3 then
        show(player, "Finish all 3 colors before replay.")
        return
    end
    state.count = 0
    state.selected = nil
    state.delivered = {}
    show(player, "New round: click parcel, then same-color bin.")
end

-- Real Luau behavior smoke. Runs only inside a successful isolated Studio Play.
-- GitHub CI's source checks do not execute these assertions.
local function runStateMachineSmoke()
    local fakePlayer = {}
    local state = {count = 0, selected = nil, delivered = {}, objective = nil}
    sessions[fakePlayer] = state
    local function verify(condition, name)
        if not condition then error("P0D_STATE_MACHINE_FAIL_" .. name) end
    end
    selectParcel(fakePlayer, "RED")
    deliver(fakePlayer, "BLUE")
    verify(state.count == 0 and state.selected == "RED", "WRONG_BIN")
    deliver(fakePlayer, "RED")
    verify(state.count == 1 and state.delivered.RED, "FIRST_DELIVERY")
    selectParcel(fakePlayer, "RED")
    deliver(fakePlayer, "RED")
    verify(state.count == 1, "NO_REPEATED_PARCEL")
    replay(fakePlayer)
    verify(state.count == 1 and state.delivered.RED, "NO_PREMATURE_REPLAY")
    selectParcel(fakePlayer, "BLUE")
    deliver(fakePlayer, "BLUE")
    selectParcel(fakePlayer, "YELLOW")
    deliver(fakePlayer, "YELLOW")
    verify(state.count == 3 and state.delivered.BLUE and state.delivered.YELLOW, "THREE_UNIQUE")
    replay(fakePlayer)
    verify(state.count == 0 and next(state.delivered) == nil, "RESET_AFTER_COMPLETE")
    sessions[fakePlayer] = nil
    print("P0D_STATE_MACHINE_SMOKE_PASS")
end
runStateMachineSmoke()

-- Orient the first player-facing view toward the color sorting station.
-- This is a disposable Studio test location, not a production teleport.
local trialSpawn = Instance.new("SpawnLocation")
trialSpawn.Name = "P0D_TestOnlySpawn"
trialSpawn.Anchored = true
trialSpawn.Neutral = true
trialSpawn.Duration = 0
trialSpawn.Size = Vector3.new(6, 1, 6)
trialSpawn.Position = Vector3.new(0, 0.5, -10)
trialSpawn.Color = Color3.fromRGB(83, 177, 123)
trialSpawn.Parent = world

makePart("TrialFloor", Vector3.new(48, 1, 36), Vector3.new(0, -0.5, -26),
    Color3.fromRGB(194, 202, 216), world)
makePart("BackWall", Vector3.new(48, 10, 1), Vector3.new(0, 5, -43),
    Color3.fromRGB(133, 175, 194), world)
makePart("LeftWall", Vector3.new(1, 10, 36), Vector3.new(-24, 5, -26),
    Color3.fromRGB(133, 175, 194), world)
makePart("RightWall", Vector3.new(1, 10, 36), Vector3.new(24, 5, -26),
    Color3.fromRGB(133, 175, 194), world)

for _, color in ipairs(colors) do
    local parcelId = color.id
    local parcel = makePart("Parcel_" .. parcelId, Vector3.new(4, 3, 4),
        Vector3.new(color.x, 1.5, -15), color.rgb, world)
    addSign(parcel, "PICK " .. parcelId, 180)
    addClick(parcel, function(player)
        selectParcel(player, parcelId)
    end)

    local bin = makePart("DeliveryBin_" .. parcelId, Vector3.new(7, 4, 6),
        Vector3.new(color.x, 2, -33), color.rgb, world)
    addSign(bin, "DELIVER " .. parcelId, 190)
    addClick(bin, function(player)
        deliver(player, parcelId)
    end)
end

local replayPillar = makePart("ReplayPillar", Vector3.new(4, 7, 4),
    Vector3.new(19, 3.5, -16), Color3.fromRGB(55, 178, 116), world)
addSign(replayPillar, "REPLAY", 160)
addClick(replayPillar, replay)

local function orientCharacter(player, character)
    -- An obsolete avatar may remain parented after a newer character spawns.
    local root = character:WaitForChild("HumanoidRootPart", 10)
    if root and character.Parent and player.Character == character then
        character:PivotTo(CFrame.lookAt(Vector3.new(0, 4, -10), Vector3.new(0, 4, -28)))
    end
end

local function join(player)
    player.RespawnLocation = trialSpawn
    player.CharacterAdded:Connect(function(character)
        task.defer(orientCharacter, player, character)
    end)
    if player.Character then
        task.defer(orientCharacter, player, player.Character)
    end
    local state = {count = 0, selected = nil, delivered = {}, objective = nil}
    sessions[player] = state
    state.objective = ensureHUD(player)
    show(player, "Click a parcel, then a same-color delivery bin.")
end

Players.PlayerAdded:Connect(join)
Players.PlayerRemoving:Connect(function(player)
    sessions[player] = nil
end)
for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(join, player)
end
print("P0D_SORTING_POSTOFFICE_TRIAL_READY | no save/publish/purchases/persistence")
