--!nocheck
-- CONCAT with the real authored NeutralElitePhasePolicy.luau sans final return.
-- Run in immutable native Luau CLI, never under client authority.
local count=0
local function check(name,ok)
    count+=1
    assert(ok,"P0D_017_"..name)
end
local s,why=Elite.spawn(1,"GOROGAN",0,true,nil)
check("giant_spawn",s~=nil and why=="CREATED")
check("starts_ready",s.phase=="READY" and s.attackCount==0)
check("one_per_round",select(2,Elite.spawn(1,"RAIGALD",0,true,s))=="MAX_ONE")
check("invalid_zero_round",Elite.spawn(0,"GOROGAN",0,true,nil)==nil)
check("invalid_fractional_round",Elite.spawn(1.4,"GOROGAN",0,true,nil)==nil)
check("invalid_kind",Elite.spawn(1,"FOO",0,true,nil)==nil)
check("not_active",Elite.spawn(1,"GOROGAN",0,false,nil)==nil)
check("bad_clock",Elite.spawn(1,"GOROGAN",0/0,true,nil)==nil)
check("giant_far",Elite.step(s,1,0,13,true,true).kind=="NONE")
check("giant_blocked",Elite.step(s,1,0,3,false,true).kind=="NONE")
local warning=Elite.step(s,1,1,11,true,true)
check("giant_warn",warning.kind=="WARN")
check("giant_visual",warning.visual=="GROUND_SHOCK")
check("giant_2sec",warning.seconds==2.0)
check("giant_no_early",Elite.step(s,1,2,11,true,true).kind=="NONE")
check("giant_cancel_los",Elite.step(s,1,3,11,false,true).kind=="CANCEL")
check("giant_cooldown",Elite.step(s,1,3.5,4,true,true).kind=="NONE")
check("giant_ready",Elite.step(s,1,4.5,4,true,true).kind=="READY")
check("giant_rewarn",Elite.step(s,1,4.6,3,true,true).kind=="WARN")
local strike=Elite.step(s,1,6.6,3,true,true)
check("giant_strike_authority_request",strike.kind=="REQUEST_HORDE_STRIKE")
check("giant_sequence",strike.sequence==1 and s.attackCount==1)
check("giant_no_repeat",Elite.step(s,1,6.6,3,true,true).kind=="NONE")
check("giant_after_recovery",Elite.step(s,1,11.6,3,true,true).kind=="READY")
check("cross_round_reject",Elite.step(s,2,12,3,true,true).kind=="INACTIVE")
check("cross_round_stops",s.live==false)
check("reopen_new_round",Elite.canStartAgain(s,2)==true)
local d=Elite.spawn(2,"RAIGALD",20,true,nil)
check("dragon_spawns",d~=nil and d.kind=="RAIGALD")
check("dragon_at18",Elite.step(d,2,20,18,true,true).kind=="WARN")
check("dragon_3sec",d.readyAt==23)
check("dragon_no_early",Elite.step(d,2,22.99,8,true,true).kind=="NONE")
local dragonStrike=Elite.step(d,2,23,8,true,true)
check("dragon_storm_request",dragonStrike.kind=="REQUEST_HORDE_STRIKE" and dragonStrike.visual=="STORM_ARC")
check("dragon_7sec_cooldown",d.readyAt==30)
check("dragon_no_repeat",Elite.step(d,2,29,8,true,true).kind=="NONE")
check("dragon_ready",Elite.step(d,2,30,8,true,true).kind=="READY")
check("dragon_bad_range_no_telegraph",Elite.step(d,2,30,19,true,true).kind=="NONE")
check("dragon_warn_again",Elite.step(d,2,30,5,true,true).kind=="WARN")
check("dragon_target_escaped_cancels",Elite.step(d,2,33,19,true,true).kind=="CANCEL")
check("reject_nan_distance",Elite.step(d,2,34,0/0,true,true).kind=="NONE")
check("reject_untrusted_visibility",Elite.step(d,2,35,4,"yes",true).kind=="READY")
check("close_once",Elite.close(d,2)==true)
check("close_twice",Elite.close(d,2)==false)
check("closed_no_attack",Elite.step(d,2,50,3,true,true).kind=="INACTIVE")
local q=Elite.spawn(5,"RAIGALD",0,true,nil)
check("different_round_new",q~=nil)
check("inactive_match_kills",Elite.step(q,5,0,4,true,false).kind=="INACTIVE" and q.live==false)
check("nonnumeric_dist_no_attack",Elite.step(s,2,12,"4",true,true).kind=="INACTIVE")
check("zero_damage_authority",Elite.VERSION=="P0D017_NEUTRAL_ELITE_PHASE_POLICY_V1")
