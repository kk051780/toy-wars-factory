--!nocheck
-- Real Luau native policy tests: Training is supplied as the EXACT module
-- source body from the generated final 65-script Rojo distribution.
local cases=0
local function check(label, ok)
    cases += 1
    assert(ok, "TWIN_TRAINING_"..label)
end

check("four_species", Training.speciesCount()==4)
check("new_level", Training.levelFor(0)==1)
check("tier3_xp", Training.levelFor(3)==2)
check("tier7_xp", Training.levelFor(7)==3)
check("effect_level1", Training.effectSeconds(1)==16)
check("effect_level2", Training.effectSeconds(2)==20)
check("effect_level3", Training.effectSeconds(3)==24)

local first,gained,promoted=Training.advance(nil,"AWARIN",0)
check("first_xp", gained and first.xp==1)
check("first_level", first.level==1 and not promoted)
check("first_cooldown", first.nextAt==20)

local repeated,repeatGained=Training.advance(first,"AWARIN",19.9)
check("cooldown_reject", not repeatGained and repeated.xp==1)
check("cooldown_no_mutate", first.xp==1 and first.nextAt==20)
local second,secondGain=Training.advance(repeated,"AWARIN",20)
check("on_time_accept", secondGain and second.xp==2)
check("second_level", second.level==1 and second.nextAt==40)
local third,thirdGain,thirdPromoted=Training.advance(second,"AWARIN",40)
check("unlock_second_stage", thirdGain and thirdPromoted and third.level==2)
check("third_xp", third.xp==3 and third.nextAt==60)
local fourth,fourthGain,fourthPromoted=Training.advance(third,"AWARIN",60)
check("fourth_xp", fourthGain and fourth.xp==4 and not fourthPromoted)
local fifth,fifthGain=Training.advance(fourth,"AWARIN",80)
check("fifth_xp", fifthGain and fifth.xp==5)
local sixth,sixthGain=Training.advance(fifth,"AWARIN",100)
check("sixth_xp", sixthGain and sixth.xp==6)
local seventh,seventhGain,seventhPromoted=Training.advance(sixth,"AWARIN",120)
check("unlock_evolution", seventhGain and seventhPromoted and seventh.level==3)
check("xp_cap_seven", seventh.xp==7 and seventh.nextAt==140)
local afterCap,afterGain,afterPromoted=Training.advance(seventh,"AWARIN",999)
check("never_infinite_grind", not afterGain and not afterPromoted and afterCap.xp==7)

local other,otherGain=Training.advance(nil,"SANGORU",0)
check("sangoru_independent", otherGain and other.xp==1)
local electric,electricGain=Training.advance(nil,"RAIKO",0)
check("raiko_independent", electricGain and electric.xp==1)
local cloud,cloudGain=Training.advance(nil,"KUMONON",0)
check("kumonon_independent", cloudGain and cloud.xp==1)

local unknown,invalid=Training.advance(nil,"UNKNOWN",0)
check("bad_species_reject", unknown==nil and invalid==false)
local missing,missingGain=Training.advance(nil,nil,0)
check("missing_species_reject", missing==nil and missingGain==false)
local badClock,badClockGain=Training.advance(nil,"AWARIN",-1)
check("negative_time_reject", badClock==nil and not badClockGain)
local nan=0/0
local nanState,nanGain=Training.advance(nil,"AWARIN",nan)
check("nan_time_reject", nanState==nil and not nanGain)
local hugeState,hugeGain=Training.advance(nil,"AWARIN",math.huge)
check("infinite_time_reject", hugeState==nil and not hugeGain)
local normalized,normGain=Training.advance({xp=-99,nextAt=-20},"AWARIN",0)
check("invalid_old_state_reset", normGain and normalized.xp==1)
local bounded,boundedGain=Training.advance({xp=9999,nextAt=0},"AWARIN",1000)
check("clamp_cap", not boundedGain and bounded.xp==7 and bounded.level==3)
local corrupt,corruptGain=Training.advance({xp=nan,nextAt=nan},"AWARIN",1)
check("nan_old_state_sanitized", corruptGain and corrupt.xp==1)
local badNext,badNextGain=Training.advance({xp=2,nextAt=math.huge},"AWARIN",20)
check("invalid_next_at_sanitized", badNextGain and badNext.level==2)
local equality,equalityGain=Training.advance({xp=2,nextAt=500},"AWARIN",500)
check("cooldown_boundary_exact", equalityGain and equality.xp==3)
local strong,strongGain=Training.advance({xp=7,level=3,nextAt=0},"AWARIN",999)
check("stage3_never_resets", not strongGain and strong.level==3)
check("unknown_level1_fallback", Training.levelFor(nan)==1)
check("effect_invalid_fallback", Training.effectSeconds(-4)==16)

assert(cases==38, "TWIN_EXPECTED_38_CASES_"..tostring(cases))
print("P0D_TWIN_CREATURE_REAL_NATIVE_38_POLICY_CASES_PASS")
