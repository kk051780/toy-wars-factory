--!nocheck
-- Native Luau tests executed against EXACT actual 66th Bond Module body.
local tested=0
local function check(name, condition)
    tested+=1
    assert(condition, "TWIN_BOND_"..name)
end
local p1,p2,p3={},{},{}
check("four_species",Bond.speciesCount()==4)
check("initial_is_one",Bond.pveMultiplier(p1,0)==1)
check("initial_snapshot_none",Bond.snapshot(p1,0)==nil)
local ok,reason=Bond.select(p1,"AWARIN",1,0)
check("level1_denied",not ok and reason=="INVALID")
check("level1_no_state",Bond.snapshot(p1,0)==nil)
ok,reason=Bond.select(p1,"AWARIN",2,0)
check("level2_accepted",ok and reason=="AWARIN")
check("level2_bonus",Bond.pveMultiplier(p1,0)==1.1)
check("level2_snapshot_id",Bond.snapshot(p1,0).species=="AWARIN")
check("level2_snapshot_level",Bond.snapshot(p1,0).level==2)
check("halfway_valid",Bond.pveMultiplier(p1,90)==1.1)
check("just_before_end",Bond.pveMultiplier(p1,179.99)==1.1)
check("on_expiry_normal",Bond.pveMultiplier(p1,180)==1)
check("on_expiry_no_snap",Bond.snapshot(p1,180)==nil)
ok,reason=Bond.select(p1,"RAIKO",3,200)
check("evolved_accepted",ok and reason=="RAIKO")
check("evolved_max20pct",Bond.pveMultiplier(p1,220)==1.2)
ok,reason=Bond.select(p1,"KUMONON",3,210)
check("switch_cooldown_reject",not ok and reason=="SWITCH_COOLDOWN")
check("switch_preserves_species",Bond.snapshot(p1,210).species=="RAIKO")
ok,reason=Bond.select(p1,"KUMONON",2,220)
check("switch_at_boundary",ok and reason=="KUMONON")
check("switch_lower_level_10pct",Bond.pveMultiplier(p1,220)==1.1)
ok,reason=Bond.select(p1,"KUMONON",3,220)
check("same_species_can_evolve",ok and reason=="KUMONON")
check("same_species_evolved_level",Bond.snapshot(p1,220).level==3)
check("evolved_bounded_bonus",Bond.pveMultiplier(p1,220)==1.2)
check("second_player_empty",Bond.pveMultiplier(p2,220)==1)
ok,reason=Bond.select(p2,"SANGORU",2,221)
check("second_player_independent",ok and reason=="SANGORU")
check("first_still_exists",Bond.pveMultiplier(p1,221)==1.2)
check("second_10pct",Bond.pveMultiplier(p2,221)==1.1)
Bond.forget(p1)
check("forget_clears_one",Bond.snapshot(p1,222)==nil)
check("forget_other_preserved",Bond.pveMultiplier(p2,222)==1.1)
Bond.forget(p2)
check("forget_clears_second",Bond.pveMultiplier(p2,223)==1)
local nilok,nilreason=Bond.select(nil,"AWARIN",3,10)
check("nil_user_fails",not nilok and nilreason=="INVALID")
local badok,badreason=Bond.select(p3,"JUNK",3,10)
check("unknown_species_fails",not badok and badreason=="INVALID")
local negativeOk=Bond.select(p3,"AWARIN",2,-1)
check("negative_time_fails",not negativeOk)
local nan=0/0
local nanOk=Bond.select(p3,"AWARIN",2,nan)
check("nan_time_fails",not nanOk)
local infOk=Bond.select(p3,"AWARIN",2,math.huge)
check("infinite_time_fails",not infOk)
local fractionalOk=Bond.select(p3,"AWARIN",2.5,11)
check("noninteger_level_fails",not fractionalOk)
local highOk=Bond.select(p3,"AWARIN",4,11)
check("high_level_rejected",not highOk)
check("not_registered_after_invalid",Bond.snapshot(p3,11)==nil)
check("bad_clock_read_returns1",Bond.pveMultiplier(p3,-1)==1)
check("nil_clock_read_returns1",Bond.pveMultiplier(p3,nil)==1)
check("nonexistent_forget_safe",(function() Bond.forget(nil) return true end)())
local same1=Bond.select(p3,"AWARIN",2,300)
check("same_species_setup",same1)
local same2=Bond.select(p3,"AWARIN",2,315)
check("same_species_refresh_valid",same2)
local switchAtOriginalDeadline=Bond.select(p3,"RAIKO",2,320)
check("same_species_does_not_delay_switch",switchAtOriginalDeadline)
local p4={}
local startOk=Bond.select(p4,"SANGORU",2,500)
check("lease_start",startOk)
local upgradeOk=Bond.select(p4,"SANGORU",3,560)
check("upgrade_preserves_first_expiry",upgradeOk
    and Bond.snapshot(p4,560).endsAt==680
    and Bond.snapshot(p4,560).level==3)
check("upgrade_bonus_before_expiry",Bond.pveMultiplier(p4,679.99)==1.2)
check("no_prompt_spam_expiry_extension",Bond.pveMultiplier(p4,680)==1)
assert(tested==47, "TWIN_BOND_EXPECTED47_GOT_"..tostring(tested))
