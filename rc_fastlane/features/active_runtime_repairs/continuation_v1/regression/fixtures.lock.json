        "id": "PAIR_CONFIRMS_PARENT_REVISION_BEFORE_NEW_EQUIP",
        "original": " local old=submit(e,p,olderKind,true)\n local newer=submit(e,p,newerKind,false)\n eq(e:outstanding(),2)\n -- A commits first, B commits second, but B's unconfirmed response is\n -- delivered first. A's valid response still carries its own earlier rev1.\n e:commit(old);eq(e:stored(p).revision,1)\n if commitNewer then e:commit(newer);eq(e:stored(p).revision,2) end\n",
        "variant": " local old=submit(e,p,olderKind,true)\n local newer\n if newerKind=='equip' and commitNewer then\n  -- Hold A's ACK, but confirm its revision through the actual Game load\n  -- before accepting B. No load occurs after B records its failed episode.\n  e:commit(old);eq(e:stored(p).revision,1)\n  e:load(p);eq(e.status[p],'SAVED');eq(e.profiles[p].revision,1)\n  eq(e:outstanding(),1,'the load must not complete the held write ACK')\n  newer=submit(e,p,newerKind,false)\n else\n  -- Non-equipment and unknown-no-commit controls keep their original order.\n  newer=submit(e,p,newerKind,false)\n  e:commit(old);eq(e:stored(p).revision,1)\n end\n eq(e:outstanding(),2)\n if commitNewer then e:commit(newer);eq(e:stored(p).revision,2) end\n",
