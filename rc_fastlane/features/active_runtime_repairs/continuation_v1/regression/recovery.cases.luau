local passed,failed=0,0
local function eq(a,b,why)assert(a==b,(why or "mismatch").." expected="..tostring(b).." actual="..tostring(a))end
local function requireJob(job)assert(job,"explicit equipment retry must contact the real Store");return job end
local function failOnce(e,p,seq)
 local a=requireJob(e:equip(p,"forest_scout",seq or 1));e:deliver(a,false)
 eq(e.status[p],"SAVE_FAILED");eq(e:outstanding(),0)
end
local function test(name,fn)
 local ok,detail=pcall(fn)
 if ok then passed+=1 else failed+=1 end
 print("CASE\t"..name.."\t"..(ok and "PASS"or "FAIL").."\t"..tostring(detail or "contract satisfied"))
end
test("explicit_retry_after_failed_then_successful_older_request",function()
 local e=newEnvironment();local p=e:newPlayer()
 local a=requireJob(e:equip(p,"forest_scout",1));local b=requireJob(e:equip(p,"star_scout",2))
 e:commit(b);e:deliver(a,false);e:deliver(b,true)
 eq(e.status[p],"SAVE_FAILED","pre-failure success cannot silently recover")
 local c=requireJob(e:equip(p,"starter_scout",3));eq(e.status[p],"SAVE_FAILED")
 e:deliver(c,true);eq(e.status[p],"SAVED");eq(e:stored(p).equipped,"starter_scout")
 eq(e:equipped(p),"starter_scout");eq(e:outstanding(),0)
end)
test("REVISION_V1_first_commit_survives_unknown_old_ack_and_explicit_retry",function()
 local e=newEnvironment();local p=e:newPlayer()
 local a=requireJob(e:equip(p,"star_scout",1));local b=requireJob(e:equip(p,"forest_scout",2))
 e:commit(b);e:commit(a);e:deliver(a,false);e:deliver(b,true)
 eq(e:stored(p).equipped,"forest_scout");eq(e.profiles[p].equipped,"forest_scout")
 eq(e:stored(p).revision,1);eq(e.profiles[p].revision,1)
 eq(e.status[p],"SAVE_FAILED","a later success cannot silently erase the unknown old ACK")
 local c=requireJob(e:equip(p,"starter_scout",3));e:deliver(c,true)
 eq(e.status[p],"SAVED");eq(e.profiles[p].revision,2);eq(e:stored(p).revision,2)
 eq(e:equipped(p),"starter_scout");eq(e:outstanding(),0)
end)
test("another_player_failure_does_not_cancel_this_recovery",function()
 local e=newEnvironment();local p=e:newPlayer();local q=e:newPlayer(7010000002)
 failOnce(e,p)
 local c=requireJob(e:equip(p,"star_scout",2));local other=requireJob(e:equip(q,"forest_scout",1))
 e:deliver(other,false);e:deliver(c,true)
 eq(e.status[p],"SAVED");eq(e.status[q],"SAVE_FAILED");eq(e:outstanding(),0)
end)
test("new_failure_invalidates_old_retry_then_next_intent_recovers",function()
 local e=newEnvironment();local p=e:newPlayer();failOnce(e,p)
 local c=requireJob(e:equip(p,"star_scout",2));local d=requireJob(e:equip(p,"forest_scout",3))
 e:commit(c);e:deliver(d,false);e:deliver(c,true)
 eq(e.status[p],"SAVE_FAILED","new failed operation must remain visible")
 local next=requireJob(e:equip(p,"starter_scout",4));e:deliver(next,true)
 eq(e.status[p],"SAVED");eq(e:stored(p).equipped,"starter_scout");eq(e:outstanding(),0)
end)
test("actual_reward_failure_during_recovery_stays_non_equipment",function()
 local e=newEnvironment();local p=e:newPlayer();failOnce(e,p)
 local c=requireJob(e:equip(p,"star_scout",2))
 e:reward(p,"Sreal_game_reward_20261122:3","forest_scout")
 e:deliver(c,true);eq(e.status[p],"SAVE_FAILED")
 local count=#e.jobs;eq(e:equip(p,"starter_scout",3),nil)
 eq(#e.jobs,count);eq(e:stored(p).equipped,"star_scout");eq(e.status[p],"SAVE_FAILED")
end)
test("REVISION_V1_missing_profile_rejects_before_async_and_cannot_recover",function()
 local e=newEnvironment();local p=e:newPlayer();local durable=e.clone(e:stored(p))
 e:clearCache(p);local count=#e.jobs
 eq(e:equip(p,"forest_scout",1),nil,"missing cache is rejected before task.spawn")
 eq(#e.jobs,count);eq(e.status[p],"SAVE_FAILED");eq(e:outstanding(),0)
 eq(e:equip(p,"star_scout",2),nil)
 eq(#e.jobs,count);eq(e.status[p],"SAVE_FAILED");eq(e:outstanding(),0)
 assert(e.same(e:stored(p),durable),"neither request can write without a valid snapshot")
end)
test("active_round_ack_defers_equipment_restore_to_lobby",function()
 local e=newEnvironment();local p=e:newPlayer();failOnce(e,p)
 local c=requireJob(e:equip(p,"star_scout",2));e:startRound();e:deliver(c,true)
 eq(e.status[p],"SAVED");eq(e:stored(p).equipped,"star_scout")
 eq(e:equipped(p),"starter_scout");eq(e.delayed[p],true)
 e:finishRound(p);eq(e:equipped(p),"star_scout");eq(e.delayed[p],nil)
end)
test("late_retry_after_removal_does_not_revive_sidecar_or_replacement",function()
 local e=newEnvironment();local p=e:newPlayer();failOnce(e,p)
 local c=requireJob(e:equip(p,"star_scout",2));e:remove(p)
 local q=e:newPlayer(p.UserId);local frozen=e.clone(e.profiles[q]);e:deliver(c,true)
 eq(e.status[p],nil);eq(e.profiles[p],nil);eq(e.failures(p),nil)
 assert(e.same(e.profiles[q],frozen));eq(e.status[q],"SAVED");eq(e:outstanding(),0)
end)
test("actual_removal_clears_completed_failure_record",function()
 local e=newEnvironment();local p=e:newPlayer();failOnce(e,p)
 e:remove(p);eq(e.status[p],nil);eq(e.profiles[p],nil);eq(e.failures(p),nil)
end)
test("real_restore_rejection_overrides_recovery_success",function()
 local e=newEnvironment();local p=e:newPlayer(nil,10000);failOnce(e,p)
 local c=requireJob(e:equip(p,"star_scout",2));e:externalGrant(p);e:deliver(c,true)
 eq(e:stored(p).owned.forest_scout,10001)
 eq(e.status[p],"SAVE_FAILED","RewardRules rejection must remain visible")
 eq(e:equip(p,"starter_scout",3),nil);eq(e:outstanding(),0)
end)
test("REVISION_V1_conflict_refresh_then_explicit_retry_resists_old_ack",function()
 local e=newEnvironment();local p=e:newPlayer()
 local a=requireJob(e:equip(p,"star_scout",1));local b=requireJob(e:equip(p,"forest_scout",2))
 e:commit(b);e:commit(a);e:deliver(a,false)
 local episode=e.failures(p)
 local c=requireJob(e:equip(p,"starter_scout",3));e:deliver(c,true)
 eq(e.status[p],"SAVE_FAILED");eq(e.failures(p),episode)
 eq(e.profiles[p].equipped,"forest_scout");eq(e.profiles[p].revision,1)
 eq(#e.jobs,3,"a conflict cannot automatically rebase the old requested intent")
 local d=requireJob(e:equip(p,"starter_scout",4));e:deliver(d,true)
 eq(e.status[p],"SAVED");eq(e.profiles[p].revision,2)
 local frozen=e.clone(e.profiles[p]);e:deliver(b,true)
 assert(e.same(e.profiles[p],frozen));eq(e:equipped(p),"starter_scout")
 eq(e.status[p],"SAVED");eq(e:outstanding(),0)
end)
test("real_reload_ends_old_failure_episode",function()
 local e=newEnvironment();local p=e:newPlayer();failOnce(e,p)
 e:reward(p,"Sreal_game_reward_20261122:5","forest_scout")
 eq(e.status[p],"SAVE_FAILED");e:load(p);eq(e.status[p],"SAVED")
 failOnce(e,p,2)
 local c=requireJob(e:equip(p,"star_scout",3));e:deliver(c,true)
 eq(e.status[p],"SAVED");eq(e:equipped(p),"star_scout")
end)
test("actual_evolution_failure_cannot_be_hidden_by_equipment_ack",function()
 local e=newEnvironment();local p=e:newPlayer()
 local evolution=requireJob(e:evolve(p,1));local a=requireJob(e:equip(p,"forest_scout",2))
 e:deliver(a,false)
 local c=requireJob(e:equip(p,"star_scout",3))
 e:deliver(evolution,false);evolution=e:timer();e:deliver(evolution,false)
 evolution=e:timer();e:deliver(evolution,false)
 eq(e.pending[p],nil);e:deliver(c,true)
 eq(e.status[p],"SAVE_FAILED");eq(e:equip(p,"starter_scout",4),nil);eq(e:outstanding(),0)
end)
test("non_equipment_failure_cannot_be_reclassified_by_late_equipment_failure",function()
 local e=newEnvironment();local p=e:newPlayer()
 local evolution=requireJob(e:evolve(p,1));local a=requireJob(e:equip(p,"forest_scout",2))
 e:deliver(a,false)
 local c=requireJob(e:equip(p,"star_scout",3))
 e:deliver(evolution,false);evolution=e:timer();e:deliver(evolution,false)
 evolution=e:timer();e:deliver(evolution,false)
 e:deliver(c,false)
 eq(e.status[p],"SAVE_FAILED")
 eq(e:equip(p,"starter_scout",4),nil,"a late equipment failure must not erase the unresolved evolution failure")
 eq(e:outstanding(),0)
end)
print("TOTAL\t"..passed.."\t"..failed)
if failed>0 then error("independent recovery cases failed: "..failed)end
