--!nocheck
local n=0
local function check(k,ok) n+=1; assert(ok,"TALK_DIRECTOR_"..k) end
local function compose(id,signal,options)
    local facts={featureEnabled=true,speakerId=id,signal=signal}
    for k,v in pairs(options or {}) do facts[k]=v end
    return Director.Compose(facts)
end
local hello=compose("NAVI","HELLO")
check("HELLO",hello~=nil and #hello.text>0)
check("NOT_GENERATIVE_AI",hello and hello.isGeneratedAI==false)
check("VOICE_ALLOWLIST",hello and hello.voiceId=="701")
check("DISABLED",Director.Compose({featureEnabled=false,speakerId="NAVI",signal="HELLO"})==nil)
check("NO_FACTS",Director.Compose(nil)==nil)
check("BAD_FACTS",Director.Compose("hello")==nil)
check("UNKNOWN_SPEAKER",compose("HACK","HELLO")==nil)
check("BAD_SIGNAL",Director.Compose({featureEnabled=true,speakerId="NAVI",signal=999})==nil)
check("COOLDOWN_QUIET",compose("NAVI","HELLO",{cooldownActive=true})==nil)
check("HIDDEN_ENEMY_DENIED",compose("NAVI","ENEMY_ALERT",{observedByTeam=false,areaCode="west"})==nil)
local enemy=compose("NAVI","ENEMY_ALERT",{observedByTeam=true,areaCode="west"})
check("OBSERVED_ENEMY",enemy and string.find(enemy.text,"西",1,true)~=nil)
check("URGENT_ENEMY",enemy and enemy.urgent==true)
check("UNKNOWN_AREA_DENIED",compose("NAVI","ENEMY_ALERT",{observedByTeam=true,areaCode="private"})==nil)
check("EGG_NOT_CARRIER",compose("NAVI","EGG_RETURN",{ourEggCarrier=false})==nil)
check("EGG_CARRIER",compose("NAVI","EGG_RETURN",{ourEggCarrier=true})~=nil)
check("UNKNOWN_ITEM_DENIED",compose("NAVI","KNOWN_ITEM",{itemKnownByTeam=false,itemCode="star_shard",areaCode="sky"})==nil)
check("KNOWN_ITEM",compose("NAVI","KNOWN_ITEM",{itemKnownByTeam=true,itemCode="star_shard",areaCode="sky"})~=nil)
check("BAD_ITEM_CODE",compose("NAVI","KNOWN_ITEM",{itemKnownByTeam=true,itemCode="invented",areaCode="sky"})==nil)
local rumor=compose("TRICK","TRICK_RUMOR")
check("TRICK_RUMOR",rumor and #rumor.text>0)
check("TRICK_SUSPICIOUS",rumor and rumor.suspicious==true)
check("TRICK_TAUNT",compose("TRICK","TAUNT")~=nil)
check("ORACLE_INTRO",compose("ORACLE","INTRO")~=nil)
check("SECRET_NOT_UNLOCKED",compose("ORACLE","SECRET_HINT",{hintUnlocked=false,secretTier=1})==nil)
check("SECRET_TIER1",compose("ORACLE","SECRET_HINT",{hintUnlocked=true,secretTier=1})~=nil)
check("SECRET_TIER2",compose("ORACLE","SECRET_HINT",{hintUnlocked=true,secretTier=2})~=nil)
check("SECRET_INVALID_TIER",compose("ORACLE","SECRET_HINT",{hintUnlocked=true,secretTier=999})==nil)
check("WEATHER_UNKNOWN",compose("ORACLE","WEATHER",{weatherObserved=false,weatherCode="thunder"})==nil)
check("WEATHER_OBSERVED",compose("ORACLE","WEATHER",{weatherObserved=true,weatherCode="thunder"})~=nil)
check("COOLDOWN_FIRST",Director.CanSpeak(0,nil,false)==true)
check("COOLDOWN_WAIT30",Director.CanSpeak(30,0,false)==true)
check("COOLDOWN_TOO_EARLY",Director.CanSpeak(29,0,false)==false)
check("URGENT_WAIT15",Director.CanSpeak(15,0,true)==true)
check("URGENT_TOO_EARLY",Director.CanSpeak(14,0,true)==false)
check("TIME_REVERSED",Director.CanSpeak(2,9,true)==false)
check("NAN_NOW",Director.CanSpeak(0/0,nil,false)==false)
check("INF_NOW",Director.CanSpeak(math.huge,nil,false)==false)
check("NEG_NOW",Director.CanSpeak(-1,nil,false)==false)
check("NAN_PREVIOUS",Director.CanSpeak(40,0/0,false)==false)
check("INF_PREVIOUS",Director.CanSpeak(40,math.huge,false)==false)
check("NEG_PREVIOUS",Director.CanSpeak(40,-1,false)==false)
check("BAD_TIME_TYPE",Director.CanSpeak("30",nil,false)==false)
check("BAD_PREVIOUS_TYPE",Director.CanSpeak(30,"0",false)==false)
assert(n==42,"EXPECTED_TALKING_POLICY_CASES_"..tostring(n))
print("P0D_TALKING_DIRECTOR_REAL_NATIVE_42_CASES_PASS")
